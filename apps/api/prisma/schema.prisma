  updatedAt   DateTime            @updatedAt
  product     Product             @relation(fields: [productCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  versions    CastingBomVersion[]
}

model CastingBomVersion {
  id                  String                     @id @default(cuid())
  bomId               String
  version             String
  materialGradeCode   String
  productNameSnapshot String
  netWeightKg         Decimal                    @db.Decimal(12, 4)
  grossWeightKg       Decimal                    @db.Decimal(12, 4)
  yieldRate           Decimal                    @db.Decimal(12, 4)
  returnWeightKg      Decimal                    @db.Decimal(12, 4)
  status              String                     @default("DRAFT")
  sourceVersionId     String?
  createdByUserId     String?
  remark              String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  bom                 CastingBom                 @relation(fields: [bomId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  materialGrade       MaterialGrade              @relation(fields: [materialGradeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  sourceVersion       CastingBomVersion?         @relation("BomVersionSource", fields: [sourceVersionId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  derivedVersions     CastingBomVersion[]        @relation("BomVersionSource")
  createdBy           User?                      @relation("BomVersionCreator", fields: [createdByUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
