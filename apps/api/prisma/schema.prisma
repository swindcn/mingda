  coreBox             CoreBoxMaster     @relation(fields: [coreBoxCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@id([bomVersionId, coreBoxCode])
  @@index([coreBoxCode])
}

model WorkOrder {
  id                        String                    @id @default(cuid())
  code                      String                    @unique
  source                    String                    @default("MANUAL")
  externalNo                String?
  productCode               String
  productCodeSnapshot       String
  productNameSnapshot       String
  bomVersionId              String
  bomCodeSnapshot           String
  bomVersionSnapshot        String
  routingVersionId          String
  routingCodeSnapshot       String
  routingNameSnapshot       String
  routingVersionSnapshot    String
  materialGradeCode         String
  materialGradeNameSnapshot String
  plannedQuantity           Int
  plannedStartDate          DateTime?                 @db.Date
  plannedDeliveryDate       DateTime                  @db.Date
  priority                  String                    @default("NORMAL")
  unitNetWeightKg           Decimal                   @db.Decimal(14, 4)
  unitGrossWeightKg         Decimal                   @db.Decimal(14, 4)
  yieldRate                 Decimal                   @db.Decimal(8, 4)
  unitReturnWeightKg        Decimal                   @db.Decimal(14, 4)
  totalNetWeightKg          Decimal                   @db.Decimal(14, 4)
  totalMeltWeightKg         Decimal                   @db.Decimal(14, 4)
  expectedReturnWeightKg    Decimal                   @db.Decimal(14, 4)
  scheduledQuantity         Int                       @default(0)
  meltCompletedQuantity     Int                       @default(0)
  meltCompletedWeightKg     Decimal                   @default(0) @db.Decimal(14, 4)
  completedQuantity         Int                       @default(0)
  scheduleStatus            WorkOrderScheduleStatus   @default(PENDING)
  productionStatus          WorkOrderProductionStatus @default(RELEASED)
  meltCompletedAt           DateTime?
  completedAt               DateTime?
  closedAt                  DateTime?
  closeReason               String?
  versionNo                 Int                       @default(1)
  remark                    String?
  createdByUserId           String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  product                   Product                   @relation(fields: [productCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  bomVersion                CastingBomVersion         @relation(fields: [bomVersionId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  routingVersion            ProcessRoutingVersion     @relation(fields: [routingVersionId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  materialGrade             MaterialGrade             @relation(fields: [materialGradeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  createdBy                 User?                     @relation("WorkOrderCreator", fields: [createdByUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  allocations               HeatOrderAllocation[]
  coreTasks                 CoreProductionTask[]

  @@index([productCode])
  @@index([bomVersionId])
  @@index([routingVersionId])
  @@index([materialGradeCode])
  @@index([scheduleStatus])
  @@index([productionStatus])
  @@index([plannedDeliveryDate])
  @@index([createdByUserId])
}

model CoreProductionTask {
  id                         String                 @id @default(cuid())
  code                       String                 @unique
  workOrderId                String
  bomVersionId               String
  routingNodeId              String
  coreBoxCode                String
  productCodeSnapshot        String
  productNameSnapshot        String
  workOrderCodeSnapshot      String
  bomCodeSnapshot            String
  bomVersionSnapshot         String
  routingCodeSnapshot        String
  routingVersionSnapshot     String
  operationCodeSnapshot      String
  operationNameSnapshot      String
  coreBoxNameSnapshot        String
  moldCodeSnapshot           String
  moldNameSnapshot           String
  quantityPerProductSnapshot Decimal                @db.Decimal(12, 4)
  cavityCountSnapshot        Int
  shelfLifeHoursSnapshot     Decimal?               @db.Decimal(12, 4)
  expectedScrapRate          Decimal                @default(0) @db.Decimal(8, 4)
  plannedQuantity            Int
  plannedPressCount          Int
  equipmentCode              String?
  equipmentNameSnapshot      String?
  teamCode                   String?
  teamNameSnapshot           String?
  plannedStartAt             DateTime?
  qualifiedQuantity          Int                    @default(0)
  scrapQuantity              Int                    @default(0)
  status                     CoreTaskStatus         @default(PENDING_DISPATCH)
  versionNo                  Int                    @default(1)
  remark                     String?
  createdByUserId            String?
  startedByUserId            String?
  startedAt                  DateTime?
  completedByUserId          String?
  completedAt                DateTime?
  canceledByUserId           String?
  canceledAt                 DateTime?
  cancelReason               String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  workOrder                  WorkOrder              @relation(fields: [workOrderId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  bomVersion                 CastingBomVersion      @relation(fields: [bomVersionId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  routingNode                ProcessRoutingNode     @relation(fields: [routingNodeId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  coreBox                    CoreBoxMaster          @relation(fields: [coreBoxCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  equipment                  Furnace?               @relation("CoreTaskEquipment", fields: [equipmentCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  team                       Team?                  @relation(fields: [teamCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  createdBy                  User?                  @relation("CoreTaskCreator", fields: [createdByUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  startedBy                  User?                  @relation("CoreTaskStarter", fields: [startedByUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  completedBy                User?                  @relation("CoreTaskCompleter", fields: [completedByUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  canceledBy                 User?                  @relation("CoreTaskCanceler", fields: [canceledByUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  reports                    CoreProductionReport[]

  @@unique([workOrderId, coreBoxCode])
  @@index([bomVersionId])
  @@index([routingNodeId])
  @@index([coreBoxCode])
  @@index([equipmentCode])
  @@index([teamCode])
  @@index([status])
  @@index([plannedStartAt])
}

model CoreProductionReport {
  id                    String              @id @default(cuid())
  taskId                String
  equipmentCode         String
  equipmentNameSnapshot String
  teamCode              String
  teamNameSnapshot      String
  shiftCode             String?
  operatorUserId        String?
  operatorNameSnapshot  String
  sandBatchCode         String?
  qualifiedQuantity     Int
  scrapQuantity         Int                 @default(0)
  defectReason          String?
