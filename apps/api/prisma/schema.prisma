  routingNameSnapshot      String
  routingVersionSnapshot   String
  operationCodeSnapshot    String
  operationNameSnapshot    String
  originalQuantity         Int
  remainingQuantity        Int
  status                   InspectionBatchStatus        @default(WAITING)
  versionNo                Int                          @default(1)
  availableAt              DateTime                     @default(now())
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  sourceBlankOutputBatch   BlankOutputBatch?            @relation("InspectionBatchSourceBlankOutput", fields: [sourceBlankOutputBatchId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  sourceReworkReport       CleaningReworkReport?        @relation("InspectionBatchSourceReworkReport", fields: [sourceReworkReportId], references: [id], onUpdate: Cascade, onDelete: Restrict)
