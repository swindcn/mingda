generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  SUPER_ADMIN
  EMPLOYEE
  SUPPLIER
  CUSTOMER
}

enum UserStatus {
  ENABLED
  DISABLED
}

enum LockStatus {
  NORMAL
  LOCKED
}

enum SyncProvider {
  LOCAL
  DINGTALK
  WECHAT_WORK
  LARK
}

enum DataScope {
  ALL
  OWN
  OWN_DEPARTMENT
  OWN_AND_CHILD_DEPARTMENTS
  CUSTOM_DEPARTMENTS
}

enum MoldDevelopmentStatus {
  WAITING_SUPPLIER_CONFIRM
  SUPPLIER_CONFIRMED
  MAKING
  FINISHED_WAITING_SHIPMENT
  SHIPPED
  RECEIVED
  TRIAL_PRODUCTION
  COMPLETED
  CANCELLED
}

enum MoldFlowKey {
  ISSUE
  CONFIRM
  SHIPPING
  RECEIVE
}

enum MoldProductionRecordType {
  TRIAL
  BATCH
  EVALUATION
}

model Department {
  id                 String       @id @default(cuid())
  name               String
  code               String       @unique
  parentId           String?
  parent             Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children           Department[] @relation("DepartmentTree")
  source             SyncProvider @default(LOCAL)
  externalId         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  users              User[]
  ownedUsers         User[]       @relation("UserOwnerDepartment")
  createdBusinessData BusinessDataOwnership[] @relation("BusinessDataCreatedDepartment")
  ownedBusinessData   BusinessDataOwnership[] @relation("BusinessDataOwnerDepartment")

  @@index([parentId])
  @@index([source, externalId])
}

model User {
  id                    String       @id @default(cuid())
  username              String?      @unique
  name                  String
  phone                 String       @unique
  passwordHash          String?
  userType              UserType     @default(EMPLOYEE)
  organizationName      String?
  departmentId          String?
  department            Department?  @relation(fields: [departmentId], references: [id])
  ownerDepartmentId     String?
  ownerDepartment       Department?  @relation("UserOwnerDepartment", fields: [ownerDepartmentId], references: [id])
  position              String?
  status                UserStatus   @default(ENABLED)
  lockStatus            LockStatus   @default(NORMAL)
  source                SyncProvider @default(LOCAL)
  externalId            String?
  belongsTo             String?
  deletedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  roles                 UserRole[]
  createdBusinessData   BusinessDataOwnership[] @relation("BusinessDataCreatedUser")
  ownedBusinessData     BusinessDataOwnership[] @relation("BusinessDataOwnerUser")
  leadingTeams          Team[]       @relation("TeamLeader")
  teamMemberships       TeamMember[]

  @@index([departmentId])
  @@index([ownerDepartmentId])
  @@index([source, externalId])
  @@index([deletedAt])
}

model Role {
  id                 String       @id @default(cuid())
  name               String
  organizationName   String?
  description        String?
  app                String       @default("admin")
  dataScope          DataScope    @default(OWN)
  dataScopes         Json         @default("[]")
  permissions        Json         @default("[]")
  columnPermissions  Json         @default("[]")
  customDepartments  Json         @default("[]")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  users              UserRole[]

  @@unique([name, app])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model DictionarySetting {
  key       String   @id
  values    Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  contact   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  molds     MoldDevelopment[]
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  contact   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  molds     MoldDevelopment[]
  moldMasters MoldMaster[]
}

model Product {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  spec          String?
  unit          String?
  type          String?
  source        String?
  workshop      String?
  purchaseUnit  String?
  salesUnit     String?
  inventoryUnit String?
  unitConversions Json  @default("[]")
  salePrice     Decimal? @db.Decimal(12, 2)
  costPrice     Decimal? @db.Decimal(12, 2)
  stockMax      Int?
  stockMin      Int?
  minPurchase   Int?
  dailyCapacity Int?
  remark        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  molds         MoldDevelopment[]
  moldMasters   MoldMaster[]
  routings      ProcessRouting[]
  recipeItems   MeltRecipeItem[]
}

model MoldDevelopment {
  id                    String                @id @default(cuid())
  code                  String                @unique
  customerId            String
  customer              Customer              @relation(fields: [customerId], references: [id])
  productId             String
  product               Product               @relation(fields: [productId], references: [id])
  supplierId            String
  supplier              Supplier              @relation(fields: [supplierId], references: [id])
  customerNotifyDate    DateTime
  moldName              String?
  moldType              String
  followerName          String?
  expectedDate          DateTime?
  status                MoldDevelopmentStatus @default(WAITING_SUPPLIER_CONFIRM)
  archivedMoldCode      String?
  supplierPromiseDate   DateTime?
  shippedAt             DateTime?
  trackingNumber        String?
  attachments           Json                  @default("[]")
  remark                String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  flowRecords           MoldDevelopmentFlowRecord[]
  productionRecords     MoldProductionRecord[]
}

model MoldDevelopmentFlowRecord {
  id                String          @id @default(cuid())
  moldDevelopmentId String
  moldDevelopment   MoldDevelopment @relation(fields: [moldDevelopmentId], references: [id], onDelete: Cascade)
  key               MoldFlowKey
  title             String
  done              Boolean         @default(false)
  operator          String?
  operatedAt        DateTime?
  trackingNumber    String?
  images            Json            @default("[]")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([moldDevelopmentId, key])
  @@index([moldDevelopmentId])
}

model MoldProductionRecord {
  id                String                   @id @default(cuid())
  moldDevelopmentId String
  moldDevelopment   MoldDevelopment          @relation(fields: [moldDevelopmentId], references: [id], onDelete: Cascade)
  type              MoldProductionRecordType
  title             String
  operator          String?
  images            Json                     @default("[]")
  result            String?
  isComplete        Boolean?
  reason            String?
  createdAt         DateTime                 @default(now())

  @@index([moldDevelopmentId])
  @@index([type])
}

model BusinessDataOwnership {
  id                    String      @id @default(cuid())
  entityType            String
  entityId              String
  createdByUserId       String?
  createdByDepartmentId String?
  ownerUserId           String?
  ownerDepartmentId     String?
  createdByUser         User?       @relation("BusinessDataCreatedUser", fields: [createdByUserId], references: [id])
  createdByDepartment   Department? @relation("BusinessDataCreatedDepartment", fields: [createdByDepartmentId], references: [id])
  ownerUser             User?       @relation("BusinessDataOwnerUser", fields: [ownerUserId], references: [id])
  ownerDepartment       Department? @relation("BusinessDataOwnerDepartment", fields: [ownerDepartmentId], references: [id])
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([entityType, entityId])
  @@index([createdByUserId])
  @@index([createdByDepartmentId])
  @@index([ownerUserId])
  @@index([ownerDepartmentId])
}

model Workshop {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String?
  status    String   @default("启用")
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines     ProductionLine[]
  teams     Team[]
  furnaces  Furnace[]
  routingSteps ProcessRoutingStep[]
  schedules ShiftSchedule[]

  @@index([status])
}

model ProductionLine {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  workshopCode String
  isBottleneck Boolean  @default(false)
  status       String   @default("启用")
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workshop     Workshop @relation(fields: [workshopCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  routingSteps ProcessRoutingStep[]

  @@index([workshopCode])
  @@index([status])
}

model Team {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  workshopCode  String
  leaderUserId  String?
  memberUserIds Json     @default("[]")
  status        String   @default("启用")
  remark        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  workshop      Workshop @relation(fields: [workshopCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  leader        User?    @relation("TeamLeader", fields: [leaderUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  schedules     ShiftSchedule[]
  members       TeamMember[]

  @@index([workshopCode])
  @@index([leaderUserId])
  @@index([status])
}

model MesItem {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String
  spec      String?
  unit      String?
  status    String   @default("启用")
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
}

model MaterialGrade {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  standard      String?
  elementLimits Json     @default("[]")
  status        String   @default("启用")
  remark        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  recipes       MeltRecipe[]
  allowedFurnaces FurnaceAllowedMaterial[]

  @@index([status])
}

model Furnace {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  workshopCode          String?
  capacity              Decimal? @db.Decimal(12, 2)
  allowedMaterialCodes  Json     @default("[]")
  status                String   @default("启用")
  remark                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  workshop              Workshop? @relation(fields: [workshopCode], references: [code], onUpdate: Cascade, onDelete: SetNull)
  allowedMaterials      FurnaceAllowedMaterial[]

  @@index([workshopCode])
  @@index([status])
}

model MeltRecipe {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  materialGradeCode String
  version           String?
  items             Json     @default("[]")
  status            String   @default("启用")
  remark            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  materialGrade     MaterialGrade @relation(fields: [materialGradeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  recipeItems       MeltRecipeItem[]

  @@index([materialGradeCode])
  @@index([status])
}

model MoldMaster {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  itemCode      String
  moldType      String?
  supplierCode  String?
  specModel     String?
  sourceMoldDevelopmentCode String?
  hasCoreBox    Boolean  @default(false)
  images        Json     @default("[]")
  cavityCount   Int?
  maxLife       Int?
  usedLife      Int      @default(0)
  status        String   @default("启用")
  remark        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  item          Product @relation(fields: [itemCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  supplier      Supplier? @relation(fields: [supplierCode], references: [code], onUpdate: Cascade, onDelete: SetNull)
  coreBoxes     CoreBoxMaster[]

  @@index([itemCode])
  @@index([supplierCode])
  @@index([sourceMoldDevelopmentCode])
  @@index([status])
}

model CoreBoxMaster {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  moldCode    String
  images      Json     @default("[]")
  cavityCount Int?
  maxLife     Int?
  usedLife    Int      @default(0)
  status      String   @default("启用")
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mold        MoldMaster @relation(fields: [moldCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([moldCode])
  @@index([status])
}

model ProcessRouting {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  itemCode  String
  version   String?
  status    String   @default("启用")
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  steps     ProcessRoutingStep[]
  item      Product @relation(fields: [itemCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([itemCode])
  @@index([status])
}

model ProcessRoutingStep {
  id                 String         @id @default(cuid())
  routingId          String
  routing            ProcessRouting @relation(fields: [routingId], references: [id], onDelete: Cascade)
  seqNo              Int
  operationName      String
  workshopCode       String
  productionLineCode String?
  standardHours      Decimal?       @db.Decimal(12, 2)
  remark             String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  workshop           Workshop       @relation(fields: [workshopCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  productionLine     ProductionLine? @relation(fields: [productionLineCode], references: [code], onUpdate: Cascade, onDelete: SetNull)

  @@index([routingId])
  @@index([workshopCode])
  @@index([productionLineCode])
}

model ShiftMaster {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  startTime String
  endTime   String
  crossDay  Boolean  @default(false)
  status    String   @default("启用")
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schedules ShiftSchedule[]
  calendarDays FactoryCalendarShift[]

  @@index([status])
}

model FactoryCalendar {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  dayType     String   @default("工作日")
  shiftCodes  Json     @default("[]")
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shifts      FactoryCalendarShift[]

  @@index([dayType])
}

model ShiftSchedule {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  workshopCode String
  shiftCode    String
  teamCode     String
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workshop     Workshop @relation(fields: [workshopCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  shift        ShiftMaster @relation(fields: [shiftCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  team         Team @relation(fields: [teamCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@unique([date, workshopCode, shiftCode])
  @@index([workshopCode])
  @@index([shiftCode])
  @@index([teamCode])
}

model DefectCode {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  category        String
  sourceOperation String?
  status          String   @default("启用")
  remark          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model TeamMember {
  teamCode  String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@id([teamCode, userId])
  @@index([userId])
}

model FurnaceAllowedMaterial {
  furnaceCode       String
  materialGradeCode String
  createdAt         DateTime      @default(now())
  furnace           Furnace       @relation(fields: [furnaceCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
  materialGrade     MaterialGrade @relation(fields: [materialGradeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@id([furnaceCode, materialGradeCode])
  @@index([materialGradeCode])
}

model MeltRecipeItem {
  id         String     @id @default(cuid())
  recipeCode String
  itemCode   String
  ratio      Decimal?   @db.Decimal(12, 4)
  quantity   Decimal?   @db.Decimal(12, 4)
  unit       String?
  remark     String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  recipe     MeltRecipe @relation(fields: [recipeCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
  item       Product    @relation(fields: [itemCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([recipeCode])
  @@index([itemCode])
}

model FactoryCalendarShift {
  date      DateTime        @db.Date
  shiftCode String
  createdAt DateTime        @default(now())
  calendar  FactoryCalendar @relation(fields: [date], references: [date], onUpdate: Cascade, onDelete: Cascade)
  shift     ShiftMaster     @relation(fields: [shiftCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@id([date, shiftCode])
  @@index([shiftCode])
}
