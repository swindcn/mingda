generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  SUPER_ADMIN
  EMPLOYEE
  SUPPLIER
  CUSTOMER
}

enum UserStatus {
  ENABLED
  DISABLED
}

enum LockStatus {
  NORMAL
  LOCKED
}

enum SyncProvider {
  LOCAL
  DINGTALK
  WECHAT_WORK
  LARK
}

enum DataScope {
  ALL
  OWN
  OWN_DEPARTMENT
  OWN_AND_CHILD_DEPARTMENTS
  CUSTOM_DEPARTMENTS
}

enum MoldDevelopmentStatus {
  WAITING_SUPPLIER_CONFIRM
  SUPPLIER_CONFIRMED
  MAKING
  FINISHED_WAITING_SHIPMENT
  SHIPPED
  RECEIVED
  TRIAL_PRODUCTION
  COMPLETED
  CANCELLED
}

enum MoldFlowKey {
  ISSUE
  CONFIRM
  SHIPPING
  RECEIVE
}

enum MoldProductionRecordType {
  TRIAL
  BATCH
  EVALUATION
}

enum WorkOrderScheduleStatus {
  PENDING
  PARTIAL
  FULL
}

enum WorkOrderProductionStatus {
  RELEASED
  IN_PRODUCTION
  MELT_COMPLETED
  COMPLETED
  CLOSED
}

enum HeatOrderStatus {
  WAITING
  IN_PROGRESS
  TRANSFERRING
  COMPLETED
  CANCELED
}

enum HeatOrderAction {
  CREATED
  SCHEDULE_ADJUSTED
  STARTED
  TRANSFERRED
  COMPLETED
  CANCELED
}

enum CoreTaskStatus {
  PENDING_DISPATCH
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum CoreBatchStatus {
  UNDRIED
  AVAILABLE
  WARNING
  EXPIRED
  LOCKED
  SCRAPPED
  CONSUMED
}

enum CoreInventoryAction {
  PRODUCED
  CONSUMED
  LOCKED
  UNLOCKED
  SCRAPPED
  ADJUSTED
}

model Department {
  id                  String                  @id @default(cuid())
  name                String
  code                String                  @unique
  parentId            String?
  parent              Department?             @relation("DepartmentTree", fields: [parentId], references: [id])
  children            Department[]            @relation("DepartmentTree")
  source              SyncProvider            @default(LOCAL)
  externalId          String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  users               User[]
  ownedUsers          User[]                  @relation("UserOwnerDepartment")
  createdBusinessData BusinessDataOwnership[] @relation("BusinessDataCreatedDepartment")
  ownedBusinessData   BusinessDataOwnership[] @relation("BusinessDataOwnerDepartment")

  @@index([parentId])
  @@index([source, externalId])
}

model User {
  id                     String                  @id @default(cuid())
  username               String?                 @unique
  name                   String
  phone                  String                  @unique
  passwordHash           String?
  userType               UserType                @default(EMPLOYEE)
  organizationName       String?
  departmentId           String?
  department             Department?             @relation(fields: [departmentId], references: [id])
  ownerDepartmentId      String?
  ownerDepartment        Department?             @relation("UserOwnerDepartment", fields: [ownerDepartmentId], references: [id])
  position               String?
  status                 UserStatus              @default(ENABLED)
  lockStatus             LockStatus              @default(NORMAL)
  source                 SyncProvider            @default(LOCAL)
  externalId             String?
  belongsTo              String?
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  roles                  UserRole[]
  createdBusinessData    BusinessDataOwnership[] @relation("BusinessDataCreatedUser")
  ownedBusinessData      BusinessDataOwnership[] @relation("BusinessDataOwnerUser")
  leadingTeams           Team[]                  @relation("TeamLeader")
  teamMemberships        TeamMember[]
  createdRecipes         MeltRecipe[]            @relation("RecipeCreator")
  createdBomVersions     CastingBomVersion[]     @relation("BomVersionCreator")
  createdRoutingVersions ProcessRoutingVersion[] @relation("RoutingVersionCreator")
  createdWorkOrders      WorkOrder[]             @relation("WorkOrderCreator")
  createdHeatOrders      HeatOrder[]             @relation("HeatOrderCreator")
  startedHeatOrders      HeatOrder[]             @relation("HeatOrderStarter")
  completedHeatOrders    HeatOrder[]             @relation("HeatOrderCompleter")
  canceledHeatOrders     HeatOrder[]             @relation("HeatOrderCanceler")
  heatOrderRecords       HeatOrderRecord[]       @relation("HeatOrderRecordOperator")
  heatOrderTransfers     HeatOrderTransfer[]     @relation("HeatOrderTransferOperator")
  createdCoreTasks       CoreProductionTask[]    @relation("CoreTaskCreator")
  startedCoreTasks       CoreProductionTask[]    @relation("CoreTaskStarter")
  completedCoreTasks     CoreProductionTask[]    @relation("CoreTaskCompleter")
  canceledCoreTasks      CoreProductionTask[]    @relation("CoreTaskCanceler")
  coreProductionReports  CoreProductionReport[]  @relation("CoreReportOperator")
  driedCoreBatches       CoreInventoryBatch[]    @relation("CoreBatchDryOperator")
  lockedCoreBatches      CoreInventoryBatch[]    @relation("CoreBatchLockOperator")
  scrappedCoreBatches    CoreInventoryBatch[]    @relation("CoreBatchScrapOperator")
  coreInventoryLedgers   CoreInventoryLedger[]   @relation("CoreInventoryLedgerOperator")

  @@index([departmentId])
  @@index([ownerDepartmentId])
  @@index([source, externalId])
  @@index([deletedAt])
}

model Role {
  id                String     @id @default(cuid())
  name              String
  organizationName  String?
  description       String?
  app               String     @default("admin")
  dataScope         DataScope  @default(OWN)
  dataScopes        Json       @default("[]")
  permissions       Json       @default("[]")
  columnPermissions Json       @default("[]")
  customDepartments Json       @default("[]")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  users             UserRole[]

  @@unique([name, app])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model DictionarySetting {
  key       String   @id
  values    Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String
  address   String?
  contact   String?
  phone     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  molds     MoldDevelopment[]
}

model Supplier {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String
  address     String?
  contact     String?
  phone       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  molds       MoldDevelopment[]
  moldMasters MoldMaster[]
}

model Product {
  id                  String                     @id @default(cuid())
  code                String                     @unique
  name                String
  spec                String?
  unit                String?
  type                String?
  source              String?
  workshop            String?
  purchaseUnit        String?
  salesUnit           String?
  inventoryUnit       String?
  unitConversions     Json                       @default("[]")
  salePrice           Decimal?                   @db.Decimal(12, 2)
  costPrice           Decimal?                   @db.Decimal(12, 2)
  stockMax            Int?
  stockMin            Int?
  minPurchase         Int?
  dailyCapacity       Int?
  materialGradeCode   String?
  remark              String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  molds               MoldDevelopment[]
  moldMasters         MoldMaster[]
  routingApplications RoutingApplicableProduct[]
  defaultRouting      ProductDefaultRouting?
  recipeItems         MeltRecipeItem[]
  castingBom          CastingBom?
  castingBomItems     CastingBomItem[]
  workOrders          WorkOrder[]
  materialGrade       MaterialGrade?             @relation(fields: [materialGradeCode], references: [code], onUpdate: Cascade, onDelete: SetNull)

  @@index([materialGradeCode])
}

model MoldDevelopment {
  id                  String                      @id @default(cuid())
  code                String                      @unique
  customerId          String
  customer            Customer                    @relation(fields: [customerId], references: [id])
  productId           String
  product             Product                     @relation(fields: [productId], references: [id])
  supplierId          String
  supplier            Supplier                    @relation(fields: [supplierId], references: [id])
  customerNotifyDate  DateTime
  moldName            String?
  moldType            String
  followerName        String?
  expectedDate        DateTime?
  status              MoldDevelopmentStatus       @default(WAITING_SUPPLIER_CONFIRM)
  archivedMoldCode    String?
  supplierPromiseDate DateTime?
  shippedAt           DateTime?
  trackingNumber      String?
  attachments         Json                        @default("[]")
  remark              String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  flowRecords         MoldDevelopmentFlowRecord[]
  productionRecords   MoldProductionRecord[]
}

model MoldDevelopmentFlowRecord {
  id                String          @id @default(cuid())
  moldDevelopmentId String
  moldDevelopment   MoldDevelopment @relation(fields: [moldDevelopmentId], references: [id], onDelete: Cascade)
  key               MoldFlowKey
  title             String
  done              Boolean         @default(false)
  operator          String?
  operatedAt        DateTime?
  trackingNumber    String?
  images            Json            @default("[]")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([moldDevelopmentId, key])
  @@index([moldDevelopmentId])
}

model MoldProductionRecord {
  id                String                   @id @default(cuid())
  moldDevelopmentId String
  moldDevelopment   MoldDevelopment          @relation(fields: [moldDevelopmentId], references: [id], onDelete: Cascade)
  type              MoldProductionRecordType
  title             String
  operator          String?
  images            Json                     @default("[]")
  result            String?
  isComplete        Boolean?
  reason            String?
  createdAt         DateTime                 @default(now())

  @@index([moldDevelopmentId])
  @@index([type])
}

model BusinessDataOwnership {
  id                    String      @id @default(cuid())
  entityType            String
  entityId              String
  createdByUserId       String?
  createdByDepartmentId String?
  ownerUserId           String?
  ownerDepartmentId     String?
  createdByUser         User?       @relation("BusinessDataCreatedUser", fields: [createdByUserId], references: [id])
  createdByDepartment   Department? @relation("BusinessDataCreatedDepartment", fields: [createdByDepartmentId], references: [id])
  ownerUser             User?       @relation("BusinessDataOwnerUser", fields: [ownerUserId], references: [id])
  ownerDepartment       Department? @relation("BusinessDataOwnerDepartment", fields: [ownerDepartmentId], references: [id])
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([entityType, entityId])
  @@index([createdByUserId])
  @@index([createdByDepartmentId])
  @@index([ownerUserId])
  @@index([ownerDepartmentId])
}

model Workshop {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  type      String?
  status    String           @default("启用")
  remark    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  lines     ProductionLine[]
  teams     Team[]
  furnaces  Furnace[]
  schedules ShiftSchedule[]

  @@index([status])
}

model ProductionLine {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  workshopCode String
  isBottleneck Boolean  @default(false)
  status       String   @default("启用")
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workshop     Workshop @relation(fields: [workshopCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([workshopCode])
  @@index([status])
}

model Team {
  id            String                 @id @default(cuid())
  code          String                 @unique
  name          String
  workshopCode  String
  leaderUserId  String?
  memberUserIds Json                   @default("[]")
  status        String                 @default("启用")
  remark        String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  workshop      Workshop               @relation(fields: [workshopCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  leader        User?                  @relation("TeamLeader", fields: [leaderUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  schedules     ShiftSchedule[]
  members       TeamMember[]
  heatOrders    HeatOrder[]
  coreTasks     CoreProductionTask[]
  coreReports   CoreProductionReport[]

  @@index([workshopCode])
  @@index([leaderUserId])
  @@index([status])
}

model MesItem {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String
  spec      String?
  unit      String?
  status    String   @default("启用")
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
}

model MaterialGrade {
  id                 String                         @id @default(cuid())
  code               String                         @unique
  name               String
  category           String?
  materialType       String?
  standard           String?
  standardVersion    String?
  elementLimits      Json                           @default("[]")
  status             String                         @default("启用")
  remark             String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  recipes            MeltRecipe[]
  products           Product[]
  elements           MaterialGradeElement[]
  properties         MaterialGradeProperty[]
  processRules       MaterialGradeProcessRule[]
  standardVersions   MaterialGradeStandardVersion[]
  allowedFurnaces    FurnaceAllowedMaterial[]
  castingBomVersions CastingBomVersion[]
  workOrders         WorkOrder[]
  heatOrders         HeatOrder[]

  @@index([status])
}

model MaterialGradeElement {
  id                String        @id @default(cuid())
  materialGradeCode String
  elementName       String
  valueMode         String        @default("range")
  fixedValue        Decimal?      @db.Decimal(12, 6)
  minValue          Decimal?      @db.Decimal(12, 6)
  maxValue          Decimal?      @db.Decimal(12, 6)
  unit              String        @default("%")
  remark            String?
  materialGrade     MaterialGrade @relation(fields: [materialGradeCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

  @@unique([materialGradeCode, elementName])
  @@index([materialGradeCode])
}

model MaterialGradeProperty {
  id                String        @id @default(cuid())
  materialGradeCode String
  propertyName      String
  valueMode         String        @default("range")
  fixedValue        Decimal?      @db.Decimal(12, 4)
  minValue          Decimal?      @db.Decimal(12, 4)
  maxValue          Decimal?      @db.Decimal(12, 4)
  unit              String?
  testMethod        String?
  remark            String?
  materialGrade     MaterialGrade @relation(fields: [materialGradeCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

  @@unique([materialGradeCode, propertyName])
  @@index([materialGradeCode])
}

model MaterialGradeProcessRule {
  id                String        @id @default(cuid())
  materialGradeCode String
  parameterName     String
  valueMode         String        @default("range")
  fixedValue        Decimal?      @db.Decimal(12, 4)
  minValue          Decimal?      @db.Decimal(12, 4)
  maxValue          Decimal?      @db.Decimal(12, 4)
  unit              String?
  textValue         String?
  remark            String?
  materialGrade     MaterialGrade @relation(fields: [materialGradeCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

  @@unique([materialGradeCode, parameterName])
  @@index([materialGradeCode])
}

model MaterialGradeStandardVersion {
  id                String        @id @default(cuid())
  materialGradeCode String
  version           String
  standard          String
  effectiveDate     DateTime?
  expiryDate        DateTime?
  status            String        @default("生效")
  remark            String?
  materialGrade     MaterialGrade @relation(fields: [materialGradeCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

  @@unique([materialGradeCode, version])
  @@index([materialGradeCode])
}

model Furnace {
  id                   String                    @id @default(cuid())
  code                 String                    @unique
  name                 String
  equipmentType        String                    @default("熔炼炉")
  workshopCode         String?
  capacity             Decimal?                  @db.Decimal(12, 2)
  capacityUnit         String?
  allowedMaterialCodes Json                      @default("[]")
  status               String                    @default("启用")
  remark               String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  workshop             Workshop?                 @relation(fields: [workshopCode], references: [code], onUpdate: Cascade, onDelete: SetNull)
  allowedMaterials     FurnaceAllowedMaterial[]
  applicableRecipes    RecipeApplicableFurnace[]
  routingNodeLinks     RoutingNodeEquipment[]
  plannedHeatOrders    HeatOrder[]               @relation("HeatOrderPlannedFurnace")
  actualHeatOrders     HeatOrder[]               @relation("HeatOrderActualFurnace")
  heatOrderTransfers   HeatOrderTransfer[]       @relation("HeatOrderTransferDevice")
  plannedCoreTasks     CoreProductionTask[]      @relation("CoreTaskEquipment")
  coreReports          CoreProductionReport[]    @relation("CoreReportEquipment")
  driedCoreBatches     CoreInventoryBatch[]      @relation("CoreBatchDryEquipment")

  @@index([workshopCode])
  @@index([equipmentType])
  @@index([status])
}

model MeltRecipe {
  id                      String                    @id @default(cuid())
  code                    String                    @unique
  name                    String
  materialGradeCode       String
  version                 String                    @default("V1.0")
  baseWeightKg            Decimal                   @default(1000) @db.Decimal(12, 4)
  meltingDurationMinutes  Int                       @default(0)
  transferDurationMinutes Int                       @default(0)
  cleaningDurationMinutes Int                       @default(0)
  sourceRecipeCode        String?
  createdByUserId         String?
  items                   Json                      @default("[]")
  status                  String                    @default("DRAFT")
  remark                  String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  materialGrade           MaterialGrade             @relation(fields: [materialGradeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  sourceRecipe            MeltRecipe?               @relation("RecipeCloneSource", fields: [sourceRecipeCode], references: [code], onUpdate: Cascade, onDelete: SetNull)
  clones                  MeltRecipe[]              @relation("RecipeCloneSource")
  createdBy               User?                     @relation("RecipeCreator", fields: [createdByUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  applicableFurnaces      RecipeApplicableFurnace[]
  targetElements          RecipeTargetElement[]
  recipeItems             MeltRecipeItem[]
  heatOrders              HeatOrder[]

  @@index([materialGradeCode])
  @@index([sourceRecipeCode])
  @@index([createdByUserId])
  @@index([status])
}

model RecipeApplicableFurnace {
  recipeCode  String
  furnaceCode String
  createdAt   DateTime   @default(now())
  recipe      MeltRecipe @relation(fields: [recipeCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
  furnace     Furnace    @relation(fields: [furnaceCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@id([recipeCode, furnaceCode])
  @@index([furnaceCode])
}

model RecipeTargetElement {
  id          String     @id @default(cuid())
  recipeCode  String
  elementName String
  minValue    Decimal?   @db.Decimal(12, 6)
  maxValue    Decimal?   @db.Decimal(12, 6)
  unit        String     @default("%")
  remark      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  recipe      MeltRecipe @relation(fields: [recipeCode], references: [code], onUpdate: Cascade, onDelete: Cascade)

  @@unique([recipeCode, elementName])
  @@index([recipeCode])
}

model MoldMaster {
  id                        String                  @id @default(cuid())
  code                      String                  @unique
  name                      String
  itemCode                  String
  moldType                  String?
  supplierCode              String?
  specModel                 String?
  sourceMoldDevelopmentCode String?
  hasCoreBox                Boolean                 @default(false)
  images                    Json                    @default("[]")
  cavityCount               Int?
  maxLife                   Int?
  usedLife                  Int                     @default(0)
  status                    String                  @default("启用")
  remark                    String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  item                      Product                 @relation(fields: [itemCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  supplier                  Supplier?               @relation(fields: [supplierCode], references: [code], onUpdate: Cascade, onDelete: SetNull)
  coreBoxes                 CoreBoxMaster[]
  bomVersions               CastingBomVersionMold[]

  @@index([itemCode])
  @@index([supplierCode])
  @@index([sourceMoldDevelopmentCode])
  @@index([status])
}

model CoreBoxMaster {
  id          String                     @id @default(cuid())
  code        String                     @unique
  name        String
  moldCode    String
  images      Json                       @default("[]")
  cavityCount Int                        @default(1)
  maxLife     Int?
  usedLife    Int                        @default(0)
  status      String                     @default("启用")
  remark      String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  mold        MoldMaster                 @relation(fields: [moldCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  bomVersions CastingBomVersionCoreBox[]
  coreTasks   CoreProductionTask[]

  @@index([moldCode])
  @@index([status])
}

model OperationMaster {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  section             String
  reportMode          String               @default("BATCH")
  qualityControlPoint Boolean              @default(false)
  pouringMergePoint   Boolean              @default(false)
  status              String               @default("ENABLED")
  remark              String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  routingNodes        ProcessRoutingNode[]

  @@index([section])
  @@index([status])
}

model ProcessRouting {
  id        String                  @id @default(cuid())
  code      String                  @unique
  name      String
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  versions  ProcessRoutingVersion[]
}

model ProcessRoutingVersion {
  id              String                     @id @default(cuid())
  routingId       String
  version         String
  status          String                     @default("DRAFT")
  sourceVersionId String?
  createdByUserId String?
  remark          String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  routing         ProcessRouting             @relation(fields: [routingId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  sourceVersion   ProcessRoutingVersion?     @relation("RoutingVersionSource", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  derivedVersions ProcessRoutingVersion[]    @relation("RoutingVersionSource")
  createdBy       User?                      @relation("RoutingVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  products        RoutingApplicableProduct[]
  defaultProducts ProductDefaultRouting[]
  nodes           ProcessRoutingNode[]
  edges           ProcessRoutingEdge[]
  workOrders      WorkOrder[]

  @@unique([routingId, version])
  @@index([status])
  @@index([sourceVersionId])
  @@index([createdByUserId])
}

model RoutingApplicableProduct {
  routingVersionId String
  productCode      String
  createdAt        DateTime              @default(now())
  routingVersion   ProcessRoutingVersion @relation(fields: [routingVersionId], references: [id], onDelete: Cascade)
  product          Product               @relation(fields: [productCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@id([routingVersionId, productCode])
  @@index([productCode])
}

model ProductDefaultRouting {
  productCode      String                @id
  routingVersionId String
  updatedAt        DateTime              @updatedAt
  product          Product               @relation(fields: [productCode], references: [code], onUpdate: Cascade, onDelete: Cascade)
  routingVersion   ProcessRoutingVersion @relation(fields: [routingVersionId], references: [id], onDelete: Cascade)

  @@index([routingVersionId])
}

model ProcessRoutingNode {
  id                    String                 @id @default(cuid())
  routingVersionId      String
  operationCode         String
  seqNo                 Int
  routeType             String
  reportEnabled         Boolean                @default(true)
  qualityControlEnabled Boolean                @default(false)
  qualityRequirement    String?
  requireFurnaceBatch   Boolean                @default(false)
  requireLadle          Boolean                @default(false)
  requireCoreBatch      Boolean                @default(false)
  standardCycleSeconds  Int?
  positionX             Decimal                @default(0) @db.Decimal(12, 2)
  positionY             Decimal                @default(0) @db.Decimal(12, 2)
  remark                String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  routingVersion        ProcessRoutingVersion  @relation(fields: [routingVersionId], references: [id], onDelete: Cascade)
  operation             OperationMaster        @relation(fields: [operationCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  equipmentLinks        RoutingNodeEquipment[]
  outgoingEdges         ProcessRoutingEdge[]   @relation("RoutingEdgeSource")
  incomingEdges         ProcessRoutingEdge[]   @relation("RoutingEdgeTarget")
  coreTasks             CoreProductionTask[]

  @@unique([routingVersionId, seqNo])
  @@index([operationCode])
}

model RoutingNodeEquipment {
  routingNodeId String
  equipmentCode String
  createdAt     DateTime           @default(now())
  routingNode   ProcessRoutingNode @relation(fields: [routingNodeId], references: [id], onDelete: Cascade)
  equipment     Furnace            @relation(fields: [equipmentCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@id([routingNodeId, equipmentCode])
  @@index([equipmentCode])
}

model ProcessRoutingEdge {
  id               String                @id @default(cuid())
  routingVersionId String
  sourceNodeId     String
  targetNodeId     String
  createdAt        DateTime              @default(now())
  routingVersion   ProcessRoutingVersion @relation(fields: [routingVersionId], references: [id], onDelete: Cascade)
  sourceNode       ProcessRoutingNode    @relation("RoutingEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode       ProcessRoutingNode    @relation("RoutingEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([routingVersionId, sourceNodeId, targetNodeId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model ShiftMaster {
