model HeatOrder {
  id                               String                @id @default(cuid())
  code                             String                @unique
  materialGradeCode                String
  materialGradeNameSnapshot        String
  furnaceCode                      String
  furnaceNameSnapshot              String
  furnaceCapacityKgSnapshot        Decimal               @db.Decimal(14, 4)
  actualFurnaceCode                String?
  actualFurnaceNameSnapshot        String?
  workshopCodeSnapshot             String?
  workshopNameSnapshot             String?
  recipeCode                       String
  recipeNameSnapshot               String
  recipeVersionSnapshot            String
  teamCode                         String
  teamNameSnapshot                 String
  shiftCode                        String?
  plannedOutputAt                  DateTime
  plannedStartAt                   DateTime?
  calculatedFinishAt               DateTime?
  plannedFinishAt                  DateTime?
  meltingDurationMinutesSnapshot   Int?
  transferDurationMinutesSnapshot  Int?
  cleaningDurationMinutesSnapshot  Int?
  occupancyDurationMinutesSnapshot Int?
  finishTimeAdjusted               Boolean               @default(false)
  targetWeightKg                   Decimal               @db.Decimal(14, 4)
  actualOutputWeightKg             Decimal?              @db.Decimal(14, 4)
  status                           HeatOrderStatus       @default(WAITING)
  versionNo                        Int                   @default(1)
  startedByUserId                  String?
  startedAt                        DateTime?
  completedByUserId                String?
  completedAt                      DateTime?
  canceledByUserId                 String?
  canceledAt                       DateTime?
  cancelReason                     String?
  createdByUserId                  String?
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  materialGrade                    MaterialGrade         @relation(fields: [materialGradeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  furnace                          Furnace               @relation("HeatOrderPlannedFurnace", fields: [furnaceCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  actualFurnace                    Furnace?              @relation("HeatOrderActualFurnace", fields: [actualFurnaceCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  recipe                           MeltRecipe            @relation(fields: [recipeCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  team                             Team                  @relation(fields: [teamCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  shift                            ShiftMaster?          @relation(fields: [shiftCode], references: [code], onUpdate: Cascade, onDelete: SetNull)
  createdBy                        User?                 @relation("HeatOrderCreator", fields: [createdByUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  startedBy                        User?                 @relation("HeatOrderStarter", fields: [startedByUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  completedBy                      User?                 @relation("HeatOrderCompleter", fields: [completedByUserId], references: [id], onUpdate: Cascade, onDelete: SetNull)
