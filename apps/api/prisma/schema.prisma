  product                           Product                      @relation("InspectionReportProduct", fields: [productCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  routingVersion                    ProcessRoutingVersion        @relation("InspectionReportRoutingVersion", fields: [routingVersionId], references: [id], onUpdate: Cascade, onDelete: Restrict)
