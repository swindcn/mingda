.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.heat-card {
  padding: 26rpx 28rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.heat-code {
  flex: 1;
  min-width: 0;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.heat-material {
  margin-bottom: 16rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx 24rpx;
  margin-bottom: 16rpx;
}
.field-cell {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.heat-time {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-divider);
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: var(--color-text-muted);
  font-size: 26rpx;
}
.empty-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}