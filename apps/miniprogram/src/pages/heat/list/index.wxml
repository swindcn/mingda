<view class="page">
  <view class="tab-bar cols-4">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'tab-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="changeTab"
    >{{item.label}}</view>
  </view>

  <view class="card-list">
    <view class="heat-card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="card-head">
        <text class="heat-code">{{item.code}}</text>
        <text class="badge badge-{{item.statusTone === 'done' ? 'done' : item.statusTone === 'muted' ? 'muted' : 'active'}}">{{item.statusText}}</text>
      </view>
      <view class="heat-material">{{item.materialGradeName}} · {{item.furnaceName}}</view>
      <view class="field-grid">
        <view class="field-cell">
          <text class="field-label">目标重量</text>
          <text class="field-value">{{item.targetWeightKg}} kg</text>
        </view>
        <view class="field-cell">
          <text class="field-label">执行班组</text>
          <text class="field-value text-ellipsis">{{item.teamName}}</text>
        </view>
      </view>
      <view class="heat-time">
        <text>计划开始</text>
        <text>{{item.plannedStartText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !records.length}}" class="empty-state">
    <image class="empty-img" src="/assets/icons/empty-box.svg" />
    <view>当前暂无熔炼任务</view>
  </view>
</view>