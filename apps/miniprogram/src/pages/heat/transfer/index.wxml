<view class="operation-page">
  <view class="form-card" wx:if="{{options}}">
    <view class="form-field">
      <text class="form-label">浇注包/球化包</text>
      <view class="device-control">
        <picker class="device-picker" mode="selector" range="{{options.transferDevices}}" range-key="name" value="{{deviceIndex}}" bindchange="selectDevice">
          <view class="picker-value">{{deviceIndex >= 0 ? options.transferDevices[deviceIndex].name + '（' + options.transferDevices[deviceIndex].code + '）' : '请选择转运设备'}}</view>
        </picker>
        <view class="scan-button" hover-class="scan-button-hover" bindtap="scanDevice">
          <image class="icon icon-32 icon-primary" src="/assets/icons/scan.svg" />
        </view>
      </view>
    </view>
    <view class="form-field">
      <view class="form-label-row">
        <text class="form-label">转运重量</text>
        <text class="remaining-weight">可转运数量：<text>{{options.remainingTransferWeightKg}} kg</text></text>
      </view>
      <view class="weight-input">
        <input type="digit" value="{{weightKg}}" bindinput="inputWeight" placeholder="请输入本次转运重量" placeholder-style="color:#98a2b3" />
        <text class="weight-unit">kg</text>
      </view>
    </view>
    <view class="form-field">
      <text class="form-label">转运备注</text>
      <textarea class="form-textarea" value="{{remark}}" bindinput="inputRemark" placeholder="选填" maxlength="300" placeholder-style="color:#98a2b3" />
    </view>
  </view>
  <view class="submit-button {{submitting || loading ? 'is-disabled' : ''}}" hover-class="submit-button-hover" bindtap="submit">确认转运</view>
</view>