.operation-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.form-card {
  padding: 12rpx 28rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.remaining-weight {
  color: var(--color-text-muted);
  font-size: 24rpx;
}
.remaining-weight text {
  color: var(--color-primary);
  font-weight: 600;
}

.device-control {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.device-picker { flex: 1; min-width: 0; }

.weight-input {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  background: var(--color-bg-input);
  border: 1rpx solid transparent;
  border-radius: var(--r-md);
  box-sizing: border-box;
}
.weight-input input {
  flex: 1;
  height: 90rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}
.weight-unit {
  color: var(--color-text-muted);
  font-size: 28rpx;
}
