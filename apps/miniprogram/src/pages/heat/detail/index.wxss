.heat-detail-page { min-height: 100vh; padding: 24rpx 28rpx; background: #f5f6f8; box-sizing: border-box; }
.detail-card { padding: 28rpx; margin-bottom: 20rpx; background: #fff; border: 1rpx solid #e5e7eb; border-radius: 18rpx; }
.detail-title { display: flex; justify-content: space-between; color: #111827; font-size: 31rpx; font-weight: 700; }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx 18rpx; margin-top: 26rpx; }
.detail-grid > view { display: flex; flex-direction: column; gap: 7rpx; color: #111827; font-size: 27rpx; }
.label { color: #98a2b3; font-size: 24rpx; }
.section-title { margin-bottom: 12rpx; color: #111827; font-size: 29rpx; font-weight: 700; }
.allocation-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #eef0f4; }
.allocation-row:last-child { border-bottom: 0; }
.allocation-row > view, .record-row > view { display: flex; flex-direction: column; gap: 5rpx; }
.row-main { color: #111827; font-size: 27rpx; font-weight: 600; }
.row-sub { color: #667085; font-size: 24rpx; }
.row-right { align-items: flex-end; }
.record-row { display: flex; gap: 18rpx; padding: 16rpx 0; }
.record-dot { flex: 0 0 auto; width: 16rpx; height: 16rpx; margin-top: 10rpx; background: #1677ff; border-radius: 50%; }
.bottom-safe { height: 150rpx; }
.fixed-actions { position: fixed; right: 0; bottom: 0; left: 0; display: flex; justify-content: flex-end; gap: 16rpx; padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e5e7eb; }
.primary-action { height: 84rpx; color: #fff; font-size: 29rpx; line-height: 84rpx; background: #1677ff; border-radius: 12rpx; }
.primary-action::after { border: 0; }
