.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.card {
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

.card-section-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-bar {
  width: 6rpx;
  height: 28rpx;
  margin-right: 12rpx;
  background: var(--color-primary);
  border-radius: 999rpx;
}
.section-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

/* 摘要 */
.summary-head {
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.summary-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.summary-code {
  flex: 1;
  min-width: 0;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.summary-material {
  color: var(--color-text-secondary);
  font-size: 28rpx;
  font-weight: 600;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx 24rpx;
}
.info-cell {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

/* 列表行 */
.row-list {
  display: flex;
  flex-direction: column;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.row:last-child { border-bottom: 0; }
.row-main,
.row-extra {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.row-extra { align-items: flex-end; }
.row-title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
}
.row-sub {
  color: var(--color-text-muted);
  font-size: 24rpx;
}

/* 时间线 */
.timeline-list {
  display: flex;
  flex-direction: column;
  padding-left: 12rpx;
}
.record-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
  position: relative;
}
.record-row:not(:last-child)::after {
  position: absolute;
  top: 32rpx;
  bottom: -8rpx;
  left: 7rpx;
  width: 2rpx;
  background: var(--color-divider);
  content: '';
}
.record-dot {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  background: var(--color-primary);
  border-radius: 50%;
}
.record-body { flex: 1; min-width: 0; }
.record-title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
}
.record-meta {
  margin-top: 4rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}
.record-remark {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.empty-inline {
  padding: 48rpx 0;
  color: var(--color-text-placeholder);
  font-size: 26rpx;
  text-align: center;
}