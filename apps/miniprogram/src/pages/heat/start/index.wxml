<view class="operation-page">
  <view class="form-card" wx:if="{{options}}">
    <view class="summary-row">
      <text class="summary-label">计划熔炉</text>
      <text class="summary-value">{{options.plannedFurnaceName}}</text>
    </view>
    <view class="form-field">
      <text class="form-label">实际熔炉</text>
      <view class="device-control">
        <picker class="device-picker" mode="selector" range="{{options.furnaces}}" range-key="name" value="{{furnaceIndex}}" bindchange="selectFurnace">
          <view class="picker-value">{{furnaceIndex >= 0 ? options.furnaces[furnaceIndex].name + '（' + options.furnaces[furnaceIndex].code + '）' : '请选择熔炉'}}</view>
        </picker>
        <view class="scan-button" hover-class="scan-button-hover" bindtap="scanFurnace">
          <image class="icon icon-32 icon-primary" src="/assets/icons/scan.svg" />
        </view>
      </view>
    </view>
  </view>
  <view class="submit-button {{submitting || loading ? 'is-disabled' : ''}}" hover-class="submit-button-hover" bindtap="submit">开始生产</view>
</view>