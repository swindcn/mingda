.operation-page { min-height: 100vh; padding: 28rpx; background: #f5f6f8; box-sizing: border-box; }
.form-card { padding: 30rpx; background: #fff; border: 1rpx solid #e5e7eb; border-radius: 18rpx; }
.summary-row { display: flex; justify-content: space-between; padding-bottom: 24rpx; color: #111827; font-size: 28rpx; border-bottom: 1rpx solid #eef0f4; }
.field-label { margin: 28rpx 0 12rpx; color: #344054; font-size: 27rpx; font-weight: 600; }
.device-control { display: flex; align-items: center; gap: 16rpx; }
.device-picker { flex: 1; min-width: 0; }
.picker-value { height: 88rpx; padding: 0 20rpx; overflow: hidden; color: #111827; font-size: 27rpx; line-height: 88rpx; white-space: nowrap; text-overflow: ellipsis; border: 1rpx solid #d0d5dd; border-radius: 12rpx; box-sizing: border-box; }
.scan-button { flex: 0 0 auto; height: 72rpx; padding: 0 22rpx; color: #1677ff; font-size: 26rpx; line-height: 72rpx; background: #fff; border: 1rpx solid #1677ff; border-radius: 10rpx; }
.scan-button::after, .submit-button::after { border: 0; }
.submit-button { height: 88rpx; margin-top: 30rpx; color: #fff; font-size: 30rpx; line-height: 88rpx; background: #1677ff; border-radius: 12rpx; }
