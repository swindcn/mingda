.operation-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.form-card {
  padding: 28rpx 28rpx 12rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 24rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.summary-label { color: var(--color-text-muted); font-size: 26rpx; }
.summary-value { color: var(--color-text); font-size: 28rpx; font-weight: 600; }

.device-control {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.device-picker { flex: 1; min-width: 0; }
