<view class="complete-page">
  <view class="form-card">
    <view class="target-row">
      <text class="summary-label">目标出炉重量</text>
      <text class="summary-value">{{targetWeightKg}} kg</text>
    </view>
    <view class="target-row transfer-total">
      <text class="summary-label">转运累计重量</text>
      <text class="summary-value">{{transferTotalWeightKg}} kg</text>
    </view>
    <view class="form-field">
      <text class="form-label">实际出炉重量</text>
      <view class="weight-input">
        <input type="digit" value="{{actualOutputWeightKg}}" bindinput="inputWeight" placeholder="请输入实际重量" placeholder-style="color:#98a2b3" />
        <text class="weight-unit">kg</text>
      </view>
    </view>
    <view class="form-field">
      <text class="form-label">完工备注</text>
      <textarea class="form-textarea" value="{{remark}}" bindinput="inputRemark" placeholder="选填" maxlength="300" placeholder-style="color:#98a2b3" />
    </view>
  </view>
  <view class="submit-button {{submitting ? 'is-disabled' : ''}}" hover-class="submit-button-hover" bindtap="submit">确认完成</view>
</view>