.complete-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.form-card {
  padding: 12rpx 28rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

.target-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.target-row:first-child { padding-top: 8rpx; }
.transfer-total { border-bottom: 0; }
.summary-label { color: var(--color-text-muted); font-size: 26rpx; }
.summary-value { color: var(--color-text); font-size: 32rpx; font-weight: 700; }

.weight-input {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  background: var(--color-bg-input);
  border: 1rpx solid transparent;
  border-radius: var(--r-md);
  box-sizing: border-box;
}
.weight-input input {
  flex: 1;
  height: 90rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}
.weight-unit {
  color: var(--color-text-muted);
  font-size: 28rpx;
}
