.page{padding:20rpx 26rpx}.search-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:10rpx;margin-bottom:20rpx}.search-row input{height:80rpx;padding:0 20rpx;background:#fff;border:1rpx solid var(--color-border);border-radius:8rpx}.task-card{padding:24rpx;margin-bottom:18rpx;background:#fff;border-radius:8rpx;box-shadow:var(--shadow-md)}.head{display:flex;justify-content:space-between;align-items:center}.code,.product{font-weight:700}.product{margin-top:16rpx}.material{margin-top:6rpx;color:var(--color-text-muted)}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid var(--color-divider)}.metrics view{display:flex;flex-direction:column;gap:4rpx}.metrics text{color:var(--color-text-muted);font-size:22rpx}.metrics strong{font-size:32rpx}.empty,.load-more{padding:60rpx 0;text-align:center;color:var(--color-text-muted)}
