.page{padding:22rpx 26rpx}.card{padding:24rpx;margin-bottom:18rpx;border-radius:8rpx}.head,.record-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.code,.product{font-weight:700}.product{margin-top:14rpx}.material,.muted{margin-top:8rpx;color:var(--color-text-muted)}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid var(--color-divider)}.metrics view{display:flex;flex-direction:column}.metrics text{font-size:21rpx;color:var(--color-text-muted)}.metrics strong{font-size:30rpx}.record{padding:18rpx 0;border-bottom:1rpx solid var(--color-divider)}.record:last-child{border-bottom:0}.report-image{width:120rpx;height:120rpx;margin-top:12rpx;border-radius:6rpx}.inline-action{width:auto;height:68rpx;line-height:68rpx;margin:14rpx 0 0 auto;padding:0 24rpx;color:var(--color-primary);background:#fff;border:1rpx solid var(--color-primary);border-radius:8rpx}.empty-inline{padding:30rpx 0;text-align:center;color:var(--color-text-muted)}.bottom-space{height:130rpx}.bottom{position:fixed;left:0;right:0;bottom:0;display:flex;justify-content:flex-end;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff}.inline-action-hover{background:var(--color-primary-tint)}
