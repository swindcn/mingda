<view class="page" wx:if="{{detail}}">
  <view class="card"><view class="head"><text class="code">{{detail.code}}</text><text class="badge badge-primary">{{detail.statusText}}</text></view><view class="product">{{detail.productNameSnapshot}}（{{detail.productCodeSnapshot}}）</view><view class="material">材质 {{detail.materialGradeNameSnapshot || '-'}}</view><view class="metrics"><view><text>计划</text><strong>{{detail.plannedQuantity}}</strong></view><view><text>剩余待检</text><strong>{{detail.options.remainingQuantity}}</strong></view><view><text>返修中</text><strong>{{detail.options.openReworkQuantity}}</strong></view><view><text>已入库</text><strong>{{detail.completedQuantity}}</strong></view></view></view>
  <view class="card"><view class="section-title">质检记录</view><view class="record" wx:for="{{detail.inspectionReports}}" wx:key="id"><view class="record-head"><text>{{item.code}}</text><text class="badge {{item.status === 'ACTIVE' ? 'badge-success' : 'badge-muted'}}">{{item.status === 'ACTIVE' ? '有效' : '已撤销'}}</text></view><view>合格 {{item.goodQty}} · 返修 {{item.reworkQty}} · 报废 {{item.scrapQty}}</view><view class="muted">{{item.operatorNameSnapshot}} · {{item.reportedAt}}</view><image wx:if="{{item.image.imageUrl}}" class="report-image" mode="aspectFill" src="{{item.image.imageUrl}}" data-url="{{item.image.imageUrl}}" bindtap="previewImage"/></view><view class="empty-inline" wx:if="{{!detail.inspectionReports.length}}">暂无质检记录</view></view>
  <view class="card"><view class="section-title">清理返修</view><view class="record" wx:for="{{detail.cleaningReworkTasks}}" wx:key="id"><view class="record-head"><text>{{item.code}}</text><text>{{item.remainingQuantity}} / {{item.originalQuantity}} 件</text></view><view class="muted">{{item.operationNameSnapshot}} · {{item.status}}</view><view wx:if="{{item.allowedActions.report && item.remainingQuantity > 0}}" class="inline-action" hover-class="inline-action-hover" data-id="{{item.id}}" bindtap="goRework">返修报工</view></view><view class="empty-inline" wx:if="{{!detail.cleaningReworkTasks.length}}">暂无返修任务</view></view>
  <view class="bottom-space"></view><view class="bottom" wx:if="{{detail.options.allowedActions.report}}"><view class="submit-inline" hover-class="submit-inline-hover" bindtap="goReport">终检报工</view></view>
</view>
