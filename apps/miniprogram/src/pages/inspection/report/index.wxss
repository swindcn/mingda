/* 终检报工 · 已迁移至全局 Form UI（3 列质检结果用紧凑步进器） */

.task-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.code { font-size: 31rpx; font-weight: 700; }
.task-state { color: var(--color-text-secondary); font-size: 26rpx; }
.product { margin: 8rpx 0; color: var(--color-text-secondary); font-size: 26rpx; }

/* 三列质检结果 */
.result-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}
.cell-label {
  display: block;
  margin-bottom: 10rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

/* 紧凑步进器（3 列网格内使用） */
.qty-stepper {
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr) 56rpx;
  gap: 8rpx;
}
.qty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: var(--r-md);
  font-size: 40rpx;
  font-weight: 700;
}
.qty-btn-primary { color: #fff; background: var(--color-primary); }
.qty-input {
  height: 80rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  background: #fff;
  border: 1rpx solid var(--color-divider);
  border-radius: var(--r-md);
  box-sizing: border-box;
}

/* 附加字段块（回炉重量 / 备注） */
.field-block { margin-top: 22rpx; }
.field-block > text {
  display: block;
  margin-bottom: 10rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

/* 缺陷明细 */
.defect {
  padding: 16rpx 0;
  border-top: 1rpx solid var(--color-divider);
}
.defect-row {
  display: grid;
  grid-template-columns: 130rpx 1fr auto;
  gap: 12rpx;
  align-items: center;
  margin-top: 12rpx;
}
.defect-remove {
  min-width: 72rpx;
  color: var(--color-danger);
  font-size: 26rpx;
  text-align: center;
}

/* 缺陷图片 */
.image-wrap {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
}
.image-wrap image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-md);
}
.image-remove { min-height: 80rpx; line-height: 80rpx; color: var(--color-danger); }
.upload-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: var(--r-md);
  font-size: 26rpx;
}
.upload-btn-hover { background: var(--color-primary-tint); }

/* 固定底部提交栏 */
.bottom-space { height: 160rpx; }
.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  box-shadow: 0 -6rpx 18rpx rgba(15, 23, 42, 0.06);
}

.permission-block {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border-radius: var(--r-lg);
}
