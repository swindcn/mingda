.page{min-height:100vh;padding:22rpx 26rpx;background:var(--color-bg);box-sizing:border-box}.card{padding:24rpx;margin-bottom:18rpx;background:#fff;border-radius:8rpx;box-shadow:var(--shadow-md)}.head{display:flex;justify-content:space-between;gap:16rpx;align-items:center}.code{font-size:31rpx;font-weight:700;overflow-wrap:anywhere}.status{font-size:23rpx;color:var(--color-primary)}.product{margin-top:14rpx;font-weight:600}.meta{margin-top:8rpx;color:var(--color-text-muted);font-size:24rpx}.section-title{font-size:29rpx;font-weight:700;margin-bottom:18rpx}.sub-title{font-weight:600;margin-bottom:8rpx}.spaced{margin-top:22rpx}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.metrics view{display:flex;flex-direction:column;padding:16rpx;background:#f8fafc;border-radius:6rpx}.metrics text{font-size:23rpx;color:var(--color-text-muted)}.metrics strong{margin-top:5rpx;font-size:31rpx}.cooling{margin-top:18rpx;font-size:24rpx}.danger{color:#dc2626}.success{color:#15803d}.record{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:16rpx 0;border-bottom:1rpx solid var(--color-divider)}.record view{display:flex;flex-direction:column;gap:5rpx;min-width:0}.record view text:last-child{color:var(--color-text-muted);font-size:22rpx;overflow-wrap:anywhere}.record strong{flex-shrink:0;font-size:24rpx}.empty-inline{padding:18rpx 0;color:var(--color-text-muted)}.trace-row{display:flex;justify-content:space-between;padding:14rpx 0;border-bottom:1rpx solid var(--color-divider)}.bottom-space{height:130rpx}.bottom-actions{position:fixed;left:0;right:0;bottom:0;display:flex;justify-content:flex-end;gap:16rpx;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid var(--color-divider)}
