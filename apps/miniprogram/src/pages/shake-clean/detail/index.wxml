<view class="page" wx:if="{{options}}">
  <view class="card"><view class="head"><text class="code">{{options.moldingTaskCode}}</text><text class="status">{{options.statusText}}</text></view><view class="product">{{options.productName}}（{{options.productCode}}）</view><view class="meta">生产工单 {{options.workOrderCode}}</view></view>
  <view class="card"><view class="section-title">任务进度</view><view class="metrics"><view><text>待落砂</text><strong>{{options.shakeRemaining}}</strong></view><view><text>待清理</text><strong>{{options.cleaningRemaining}}</strong></view><view><text>落砂总数</text><strong>{{options.shakeOriginal}}</strong></view><view><text>清理总数</text><strong>{{options.cleaningOriginal}}</strong></view></view><view wx:if="{{options.cooling}}" class="cooling {{options.cooling.earlyShake ? 'danger' : 'success'}}">{{options.cooling.earlyShake ? '冷却未到期，剩余 ' + options.cooling.remainingCoolingMinutes + ' 分钟' : '已达到冷却时长'}}</view></view>
  <view class="card"><view class="section-title">报工记录</view><view class="sub-title">落砂记录</view><view class="record" wx:for="{{reports.shakeReports}}" wx:key="id"><view><text>{{item.code}}</text><text>{{item.operatorNameSnapshot}} · {{item.reportedAt}}</text></view><strong>合格 {{item.goodQty}} / 废品 {{item.scrapQty}}</strong></view><view class="empty-inline" wx:if="{{!reports.shakeReports.length}}">暂无落砂记录</view><view class="sub-title spaced">清理记录</view><view class="record" wx:for="{{reports.cleaningReports}}" wx:key="id"><view><text>{{item.code}}</text><text>{{item.operatorNameSnapshot}} · {{item.reportedAt}}</text></view><strong>合格 {{item.goodQty}} / 废品 {{item.scrapQty}}</strong></view><view class="empty-inline" wx:if="{{!reports.cleaningReports.length}}">暂无清理记录</view></view>
  <view class="card"><view class="section-title">批次追溯</view><view class="trace-row"><text>待落砂批次</text><strong>{{trace.shakeBatches.length}}</strong></view><view class="trace-row"><text>待清理批次</text><strong>{{trace.cleaningBatches.length}}</strong></view><view class="trace-row"><text>毛坯产出批次</text><strong>{{trace.blankOutputBatches.length}}</strong></view></view>
  <view class="bottom-space"></view><view class="bottom-actions"><view wx:if="{{options.allowedActions.shakeReport}}" class="submit-inline" hover-class="submit-inline-hover" bindtap="goShakeReport">落砂报工</view><view wx:if="{{options.allowedActions.cleanReport}}" class="submit-inline" hover-class="submit-inline-hover" bindtap="goCleanReport">清理报工</view></view>
</view>
