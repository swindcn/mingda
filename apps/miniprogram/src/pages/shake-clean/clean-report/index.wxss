/* 清理报工 · 已迁移至全局 Form UI（输入框 88rpx / 步进器 96rpx / 提交按钮 view hover-class） */

.task-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.code { font-size: 31rpx; font-weight: 700; }
.task-state { color: var(--color-text-secondary); font-size: 26rpx; }
.product { margin: 8rpx 0; color: var(--color-text-secondary); font-size: 26rpx; }

.spaced { margin-top: 28rpx; }

/* 快速调整 chip 行（chip 来自全局） */
.quick {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin: 16rpx 0;
}

/* 缺陷明细 */
.defect {
  padding: 16rpx 0;
  border-top: 1rpx solid var(--color-divider);
}
.defect-row {
  display: grid;
  grid-template-columns: 130rpx 1fr auto;
  gap: 12rpx;
  align-items: center;
  margin-top: 12rpx;
}
.defect-remove {
  min-width: 72rpx;
  color: var(--color-danger);
  font-size: 26rpx;
  text-align: center;
}

/* 固定底部提交栏 */
.bottom-space { height: 160rpx; }
.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  box-shadow: 0 -6rpx 18rpx rgba(15, 23, 42, 0.06);
}

.permission-block {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border-radius: var(--r-lg);
}
