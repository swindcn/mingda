<view class="page">
  <view class="tab-bar is-scroll">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{activeStatus === item.key ? 'tab-active' : ''}}" data-status="{{item.key}}" bindtap="changeTab">{{item.label}}</view>
  </view>
  <view class="search-row"><input value="{{keyword}}" placeholder="派工单、工单或任务号" bindinput="inputKeyword" confirm-type="search" bindconfirm="search"/><view class="scan-btn" hover-class="scan-btn-hover" bindtap="scanCode">扫码</view><view class="query-btn" hover-class="query-btn-hover" bindtap="search">查询</view></view>
  <view class="list">
    <view class="card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="head"><text class="code">{{item.code}}</text><text class="badge badge-{{item.statusTone}}">{{item.statusText}}</text></view>
      <view class="product">{{item.productName}}（{{item.productCode}}）</view><view class="work-order">工单 {{item.workOrderCode}}</view>
      <view class="metrics"><view><text>待落砂</text><strong>{{item.shakeRemaining}}</strong></view><view><text>待清理</text><strong>{{item.cleaningRemaining}}</strong></view><view><text>合格毛坯</text><strong>{{item.blankOutputQuantity}}</strong></view></view>
      <view class="cooling {{item.cooling && item.cooling.earlyShake ? 'danger' : 'success'}}" wx:if="{{item.cooling}}">冷却：{{item.cooling.earlyShake ? '未到期，剩余 ' + item.cooling.remainingCoolingMinutes + ' 分钟' : '已达到要求'}}</view>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && !records.length}}">暂无落砂清理任务</view>
  <view class="load-more" wx:if="{{loadingMore}}">正在加载...</view><view class="load-more" wx:elif="{{records.length && records.length >= total}}">已显示全部 {{total}} 项</view>
</view>
