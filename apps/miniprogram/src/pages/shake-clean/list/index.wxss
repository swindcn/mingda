.page{min-height:100vh;padding:18rpx 24rpx 60rpx;background:var(--color-bg);box-sizing:border-box}.search-row{display:flex;gap:12rpx;margin-bottom:20rpx}.search-row input{flex:1;height:88rpx;padding:0 22rpx;background:#fff;border:1rpx solid var(--color-border);border-radius:8rpx;box-sizing:border-box}.list{display:flex;flex-direction:column;gap:16rpx}.card{padding:24rpx;background:#fff;border-radius:8rpx;box-shadow:var(--shadow-md)}.head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.code{font-size:30rpx;font-weight:700;overflow-wrap:anywhere}.badge{flex-shrink:0;padding:5rpx 12rpx;border-radius:6rpx;font-size:23rpx}.badge-warning{color:#b7791f;background:#fff7e6}.badge-active{color:#1677ff;background:#e6f4ff}.badge-success{color:#15803d;background:#f0fdf4}.badge-muted{color:#64748b;background:#f1f5f9}.product{margin-top:14rpx;font-weight:600;overflow-wrap:anywhere}.work-order{margin-top:7rpx;font-size:24rpx;color:var(--color-text-muted)}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid var(--color-divider)}.metrics view{display:flex;flex-direction:column;gap:4rpx}.metrics text{font-size:22rpx;color:var(--color-text-muted)}.metrics strong{font-size:29rpx}.cooling{margin-top:14rpx;font-size:24rpx}.danger{color:#dc2626}.success{color:#15803d}.empty,.load-more{text-align:center;padding:70rpx 0;color:var(--color-text-muted)}.load-more{padding:28rpx 0}
