<view class="profile-page">
  <view class="profile-hero">
    <view class="profile-avatar">闽</view>
    <view class="profile-info">
      <view class="profile-name">闽大铸件</view>
      <view class="profile-sub">欢迎，{{username}}</view>
    </view>
  </view>

  <view class="section-card">
    <view class="menu-row">
      <text>当前版本</text>
      <text class="muted">0.1.0</text>
    </view>
    <view class="menu-row">
      <text>账号类型</text>
      <text class="muted">供应商协同账号</text>
    </view>
  </view>

  <button class="logout-button" bindtap="logout">退出登录</button>
</view>