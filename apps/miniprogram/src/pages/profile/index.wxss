.profile-page {
  min-height: 100vh;
  padding: 28rpx 30rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #1677ff, #4f94ff);
  border-radius: var(--r-xl);
  box-shadow: 0 12rpx 28rpx rgba(22, 119, 255, 0.24);
}
.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  font-size: 48rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.22);
  border-radius: var(--r-xl);
}
.profile-info {
  flex: 1;
  min-width: 0;
}
.profile-name {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.profile-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.section-card {
  padding: 8rpx 32rpx;
  margin-bottom: 28rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}
.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.menu-row:last-child { border-bottom: 0; }
.menu-row .muted { color: var(--color-text-muted); }

.logout-button {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  color: var(--color-danger);
  font-size: 28rpx;
  font-weight: 600;
  background: var(--color-surface);
  border: 1rpx solid var(--color-danger);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-sm);
}
.logout-button::after { border: 0; }