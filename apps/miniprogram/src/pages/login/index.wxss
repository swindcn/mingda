.login-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background:
    radial-gradient(at 0% 0%, rgba(22, 119, 255, 0.08) 0%, transparent 40%),
    radial-gradient(at 100% 100%, rgba(15, 79, 184, 0.06) 0%, transparent 50%),
    var(--color-bg);
}

.login-card {
  width: 100%;
  padding: 56rpx 40rpx;
  background: var(--color-surface);
  border-radius: var(--r-xl);
  box-shadow: var(--shadow-lg);
}

.brand-logo {
  display: block;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 28rpx;
}

.brand-title {
  color: var(--color-text);
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 4rpx;
}

.brand-subtitle {
  margin-top: 10rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
  text-align: center;
}

.login-form {
  margin-top: 56rpx;
}

.login-field {
  position: relative;
  margin-bottom: 28rpx;
}

.login-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  font-weight: 600;
}

.login-input-row {
  display: flex;
  align-items: center;
}

.login-input {
  display: block;
  width: 100%;
  height: 92rpx;
  padding: 0 24rpx;
  color: var(--color-text);
  font-size: 28rpx;
  background: var(--color-bg-input);
  border: 1rpx solid transparent;
  border-radius: var(--r-md);
  box-sizing: border-box;
  transition: border-color 0.15s, background 0.15s;
}
.login-input:focus {
  border-color: var(--color-primary);
  background: var(--color-surface);
}

/* 密码框在 flex 行内占满剩余宽度，不与右侧图标重叠 */
.login-input--password {
  flex: 1;
  min-width: 0;
}

.password-toggle {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 92rpx;
  margin-left: 8rpx;
}
.password-toggle--hover {
  opacity: 0.5;
}
.password-toggle-icon {
  width: 44rpx;
  height: 44rpx;
}

.login-form-row {
  display: flex;
  align-items: center;
  margin: 8rpx 0 36rpx;
}
.login-form-row text {
  margin-left: 10rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.login-button {
  width: 100%;
  height: 96rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  border-radius: var(--r-md);
  background: linear-gradient(145deg, #1677ff, #0958d9);
  box-shadow: 0 10rpx 24rpx rgba(22, 119, 255, 0.32);
}
.login-button::after { border: 0; }
