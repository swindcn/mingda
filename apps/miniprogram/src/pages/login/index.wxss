.login-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #eff6ff, #f8fafc);
}

.login-card {
  width: 100%;
  padding: 56rpx 40rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.12);
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(145deg, #1677ff, #0f4fb8);
  border-radius: 28rpx;
}

.brand-title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
}

.brand-subtitle {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 26rpx;
  text-align: center;
}

.form {
  margin-top: 56rpx;
}

.field {
  position: relative;
  margin-bottom: 28rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #374151;
  font-size: 26rpx;
}

.field input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.toggle {
  position: absolute;
  right: 22rpx;
  bottom: 24rpx;
  color: #1677ff;
  font-size: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  margin: 8rpx 0 32rpx;
}

.remember {
  margin-left: 10rpx;
  color: #4b5563;
  font-size: 26rpx;
}

.forgot {
  margin-left: auto;
  color: #1677ff;
  font-size: 26rpx;
}

.login-button {
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
}
