.page{min-height:100vh;padding:24rpx 28rpx;background:var(--color-bg);box-sizing:border-box}.card{padding:26rpx;margin-bottom:20rpx;background:#fff;border-radius:var(--r-lg);box-shadow:var(--shadow-md)}.head{display:flex;justify-content:space-between;align-items:center}.code{font-size:31rpx;font-weight:700}.product{margin:16rpx 0 22rpx;color:var(--color-text-secondary);font-size:28rpx}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.info-grid view{display:flex;flex-direction:column;gap:6rpx}.info-grid text,.core-row text,.report-row text{color:var(--color-text-muted);font-size:23rpx}.section-title{margin-bottom:18rpx;font-size:29rpx;font-weight:700}.core-row,.report-row{display:flex;justify-content:space-between;gap:18rpx;padding:18rpx 0;border-top:1rpx solid var(--color-divider)}.core-row>view,.report-row>view{display:flex;flex-direction:column;gap:6rpx}.qty{text-align:right}.shortage{color:#f5222d!important}.ready-text{color:#16a34a}.muted{color:var(--color-text-muted)}.bottom-space{height:150rpx}.bottom-actions{position:fixed;left:0;right:0;bottom:0;display:flex;justify-content:flex-end;gap:16rpx;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid var(--color-divider)}
