<view class="page" wx:if="{{task}}">
  <view class="card"><view class="head"><text class="code">{{task.code}}</text><text class="badge badge-active">{{task.statusText}}</text></view><view class="product">{{task.productName}}</view><view class="info-grid"><view><text>生产工单</text><strong>{{task.workOrderCode}}</strong></view><view><text>模具</text><strong>{{task.moldName}}</strong></view><view><text>产线</text><strong>{{task.productionLineName}}</strong></view><view><text>执行班组</text><strong>{{task.teamName}}</strong></view><view><text>计划箱数</text><strong>{{task.planBoxQty}}</strong></view><view><text>累计合格</text><strong>{{task.completedGoodQty}}</strong></view></view></view>
  <view class="card"><view class="section-title">砂芯齐套</view><view wx:if="{{!task.coreRequirements.length}}" class="ready-text">当前任务无需砂芯</view><view class="core-row" wx:for="{{task.readiness.requirements}}" wx:key="coreBoxCode"><view><strong>{{item.coreBoxName}}</strong><text>{{item.coreBoxCode}}</text></view><view class="qty"><text>剩余需求 {{item.remainingRequiredQuantity}}</text><text>可用 {{item.available}}</text><text wx:if="{{item.shortage}}" class="shortage">缺 {{item.shortage}}</text></view></view></view>
  <view class="card"><view class="section-title">报工记录</view><view wx:if="{{!task.reports.length}}" class="muted">暂无报工记录</view><view class="report-row" wx:for="{{task.reports}}" wx:key="id"><view><strong>{{item.reportCode}}</strong><text>{{item.operatorName}}</text></view><view><text>合格 {{item.goodQty}} / 废品 {{item.scrapQty}}</text></view></view></view>
  <view class="bottom-space"></view><view class="bottom-actions"><view wx:if="{{task.allowedActions.start}}" class="submit-inline" hover-class="submit-inline-hover" bindtap="startTask">开始生产</view><view wx:elif="{{task.startBlockedReason}}" class="submit-inline is-disabled">{{task.startBlockedReason}}</view><view wx:if="{{task.allowedActions.report}}" class="submit-inline" hover-class="submit-inline-hover" bindtap="goReport">完工报工</view></view>
</view>
