/* ===========================
 * molding/report · 造型下芯报工（表单原子见 app.wxss）
 * =========================== */

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 40rpx;
  background: var(--color-bg);
  box-sizing: border-box;
  padding-bottom: calc(40rpx + 200rpx + env(safe-area-inset-bottom));
}

/* 任务头 */
.task-card {
  padding: 30rpx 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}
.task-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.task-code {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}
.task-product {
  margin: 12rpx 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.task-meta {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* 通用卡片 */
.card {
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

/* 区段标题 */
.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-head .section-title { margin-bottom: 0; }

.zero-report-hint {
  margin: -4rpx 0 18rpx;
  padding: 16rpx 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a5a00;
  background: #fff8e6;
  border-radius: var(--r-md);
}

.radio-item-disabled {
  color: var(--color-text-muted);
  background: var(--color-bg);
  opacity: 0.6;
}

/* 快速调整 chip 行修饰 */
.quick-row {
  margin-bottom: 16rpx;
  justify-content: flex-end;
}

/* 底部留白 */
.bottom-space {
  height: 200rpx;
}
