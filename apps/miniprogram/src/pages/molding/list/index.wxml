<view class="page">
  <view class="scan-row">
    <input class="code-input" value="{{taskCode}}" placeholder="派工单号" bindinput="inputCode" confirm-type="search" bindconfirm="searchCode" />
    <view class="scan-btn" hover-class="scan-btn-hover" bindtap="scanCode">扫码</view>
    <view class="query-btn" hover-class="query-btn-hover" bindtap="searchCode">查询</view>
  </view>
  <view class="tab-bar cols-5">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'tab-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="changeTab"
    >{{item.label}}</view>
  </view>
  <view class="card-list">
    <view class="task-card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="card-head"><text class="task-code">{{item.code}}</text><text class="badge badge-{{item.statusTone}}">{{item.statusText}}</text></view>
      <view class="product-line">{{item.productName}} · {{item.moldName}}</view>
      <view class="field-grid"><view><text class="field-label">计划 / 完成</text><view class="field-value">{{item.planBoxQty}} / {{item.completedGoodQty}} 箱</view></view><view><text class="field-label">产线 / 班组</text><view class="field-value">{{item.productionLineName}} / {{item.teamName}}</view></view><view><text class="field-label">砂芯齐套</text><view class="field-value"><text class="badge badge-{{item.readinessTone}}">{{item.readinessText}}</text></view></view></view>
    </view>
  </view>
  <view wx:if="{{!loading && !records.length}}" class="empty-state"><image class="empty-img" src="/assets/icons/empty-box.svg" /><view>当前暂无造型下芯任务</view></view>
</view>
