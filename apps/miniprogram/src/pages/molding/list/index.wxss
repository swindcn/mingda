.page{min-height:100vh;padding:24rpx 28rpx 56rpx;background:var(--color-bg);box-sizing:border-box}.scan-row{display:flex;gap:12rpx;margin-bottom:20rpx}.code-input{flex:1;height:76rpx;padding:0 22rpx;background:#fff;border:1rpx solid var(--color-divider);border-radius:8rpx;box-sizing:border-box}.scan-btn,.query-btn{width:112rpx;height:76rpx;line-height:76rpx;padding:0;border-radius:8rpx;font-size:26rpx}.scan-btn{color:var(--color-primary);background:#fff;border:1rpx solid var(--color-primary)}.query-btn{color:#fff;background:var(--color-primary)}.card-list{display:flex;flex-direction:column;gap:18rpx}.task-card{padding:26rpx 28rpx;background:#fff;border-radius:var(--r-lg);box-shadow:var(--shadow-md)}.card-head{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.task-code{font-size:31rpx;font-weight:700}.product-line{margin:14rpx 0;color:var(--color-text-secondary)}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;padding-top:14rpx;border-top:1rpx solid var(--color-divider)}.field-label{color:var(--color-text-muted);font-size:23rpx}.field-value{margin-top:6rpx;font-size:26rpx}.empty-state{text-align:center;padding:110rpx 0;color:var(--color-text-muted)}.empty-img{width:120rpx;height:120rpx;opacity:.5;margin-bottom:18rpx}
