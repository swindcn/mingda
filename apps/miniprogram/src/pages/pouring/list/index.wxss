.page{min-height:100vh;padding:20rpx 28rpx 60rpx;background:var(--color-bg);box-sizing:border-box}.list{display:flex;flex-direction:column;gap:18rpx}.card{padding:26rpx 28rpx;background:#fff;border-radius:var(--r-lg);box-shadow:var(--shadow-md)}.head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.code{font-size:31rpx;font-weight:700}.product{margin:14rpx 0 20rpx;color:var(--color-text-secondary)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;padding-top:16rpx;border-top:1rpx solid var(--color-divider)}.grid view{display:flex;flex-direction:column;gap:6rpx}.grid text{font-size:23rpx;color:var(--color-text-muted)}.grid strong{font-size:26rpx}.hold-success{color:#16a34a}.hold-warning{color:#b7791f}.hold-danger{color:#dc2626}.empty{display:flex;flex-direction:column;align-items:center;padding:120rpx 0;color:var(--color-text-muted)}.empty image{width:112rpx;height:112rpx;margin-bottom:18rpx;opacity:.5}
