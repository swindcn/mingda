.page{min-height:100vh;padding:24rpx 28rpx;background:var(--color-bg);box-sizing:border-box}.card{padding:26rpx 28rpx;margin-bottom:20rpx;background:#fff;border-radius:var(--r-lg);box-shadow:var(--shadow-md)}.head,.report-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.code{font-size:31rpx;font-weight:700}.hold{font-size:23rpx}.hold-success{color:#16a34a}.hold-warning{color:#b7791f}.hold-danger{color:#dc2626}.product{margin:14rpx 0 20rpx;color:var(--color-text-secondary)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.grid view{display:flex;flex-direction:column;gap:6rpx}.grid text,.report text{font-size:23rpx;color:var(--color-text-muted)}.section-title{margin-bottom:16rpx;font-size:29rpx;font-weight:700}.report{display:flex;flex-direction:column;gap:8rpx;padding:18rpx 0;border-top:1rpx solid var(--color-divider)}.muted{color:var(--color-text-muted)}.bottom-space{height:140rpx}.bottom{position:fixed;left:0;right:0;bottom:0;display:flex;justify-content:flex-end;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid var(--color-divider)}
