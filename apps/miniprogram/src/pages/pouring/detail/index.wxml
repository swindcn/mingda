<view class="page" wx:if="{{options}}">
  <view class="card"><view class="head"><text class="code">{{options.moldingTaskCode}}</text><text class="hold hold-{{holdTone}}">{{options.holdMinutes}}分钟 · {{holdText}}</text></view><view class="product">{{options.productName}}（{{options.productCode}}）</view><view class="grid"><view><text>生产工单</text><strong>{{options.workOrderCode}}</strong></view><view><text>剩余待浇</text><strong>{{options.remainingQuantity}} 箱</strong></view><view><text>材质牌号</text><strong>{{options.materialGradeName}}</strong></view><view><text>可选包次 / 工位</text><strong>{{options.transfers.length}} / {{options.stations.length}}</strong></view></view></view>
  <view class="card"><view class="section-title">浇注记录</view><view wx:if="{{!reports.length}}" class="muted">暂无浇注记录</view><view class="report" wx:for="{{reports}}" wx:key="id"><view class="report-head"><strong>{{item.code}}</strong><text class="badge {{item.status === 'ACTIVE' ? 'badge-done' : 'badge-muted'}}">{{item.status === 'ACTIVE' ? '有效' : '已撤销'}}</text></view><text>{{item.heatOrderCodeSnapshot}} · {{item.transferDeviceNameSnapshot}}</text><text>合格 {{item.goodQty}} 箱 / 废品 {{item.scrapQty}} 箱 · {{item.actualWeightKg}} kg</text><text>{{item.operatorNameSnapshot}} · {{item.reportedAt}}</text></view></view>
  <view class="bottom-space"></view><view class="bottom" wx:if="{{options.remainingQuantity > 0}}"><view class="submit-inline" hover-class="submit-inline-hover" bindtap="goReport">浇注报工</view></view>
</view>
