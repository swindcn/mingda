.label-page { min-height: 100vh; padding: 28rpx 30rpx 56rpx; background: #f5f6f8; box-sizing: border-box; }
.label-sheet { padding: 28rpx; background: #fff; border: 1rpx solid #d0d5dd; border-radius: 12rpx; }
.label-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding-bottom: 22rpx; border-bottom: 2rpx solid #1677ff; }
.label-title { color: #111827; font-size: 32rpx; font-weight: 700; }
.task-code { min-width: 0; overflow: hidden; color: #475467; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.qr-wrap { display: flex; justify-content: center; padding: 30rpx 0 16rpx; }
.qr-canvas { width: 520rpx; height: 520rpx; background: #fff; }
.batch-code { color: #111827; font-size: 32rpx; font-weight: 700; text-align: center; overflow-wrap: anywhere; }
.label-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 26rpx; border-top: 1rpx solid #e5e7eb; border-left: 1rpx solid #e5e7eb; }
.field { display: flex; min-width: 0; min-height: 116rpx; flex-direction: column; gap: 6rpx; padding: 16rpx; border-right: 1rpx solid #e5e7eb; border-bottom: 1rpx solid #e5e7eb; box-sizing: border-box; }
.field.wide { grid-column: 1 / -1; min-height: 100rpx; }
.field-name { color: #667085; font-size: 23rpx; }
.field-value { color: #111827; font-size: 27rpx; font-weight: 600; overflow-wrap: anywhere; }
.field-code { color: #667085; font-size: 23rpx; overflow-wrap: anywhere; }
.status { color: #0958d9; }
.empty-page { min-height: 100vh; padding-top: 180rpx; color: #98a2b3; font-size: 27rpx; text-align: center; background: #f5f6f8; box-sizing: border-box; }
