.label-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.label-sheet {
  padding: 28rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

.label-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 22rpx;
  border-bottom: 4rpx solid var(--color-primary);
}
.label-title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
}
.task-code-text {
  flex: 1;
  min-width: 0;
  color: var(--color-text-muted);
  font-size: 24rpx;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qr-wrap {
  display: flex;
  justify-content: center;
  padding: 30rpx 0 16rpx;
}
.qr-canvas {
  width: 520rpx;
  height: 520rpx;
  background: #fff;
}

.batch-code {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  overflow-wrap: anywhere;
}

.label-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin-top: 26rpx;
  background: var(--color-bg-soft);
  border-top: 1rpx solid var(--color-divider);
  border-left: 1rpx solid var(--color-divider);
  border-radius: var(--r-md);
  overflow: hidden;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  min-height: 116rpx;
  padding: 16rpx 18rpx;
  background: var(--color-surface);
  border-right: 1rpx solid var(--color-divider);
  border-bottom: 1rpx solid var(--color-divider);
  box-sizing: border-box;
}
.field.wide {
  grid-column: 1 / -1;
}
.field-name {
  color: var(--color-text-muted);
  font-size: 23rpx;
}
.field-value {
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.field-code {
  color: var(--color-text-muted);
  font-size: 23rpx;
  overflow-wrap: anywhere;
}
.status { color: var(--color-primary); }

.empty-page {
  padding: 180rpx 28rpx;
  color: var(--color-text-placeholder);
  font-size: 28rpx;
  text-align: center;
}