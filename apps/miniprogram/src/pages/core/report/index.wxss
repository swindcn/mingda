.form-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.form-card {
  padding: 12rpx 28rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

.task-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0 22rpx;
  margin: 12rpx 0 12rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  font-weight: 600;
  border-bottom: 1rpx solid var(--color-divider);
}

.quantity-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 4rpx;
}

.defect-section {
  padding-top: 4rpx;
  margin: 20rpx 0;
}
.defect-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}
.defect-head .form-label { margin-bottom: 0; }
.defect-add {
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
}
.defect-empty {
  padding: 22rpx 24rpx;
  color: var(--color-text-placeholder);
  font-size: 26rpx;
  background: var(--color-bg-soft);
  border-radius: var(--r-md);
}
.defect-card {
  padding: 18rpx;
  margin-top: 14rpx;
  background: var(--color-bg-soft);
  border-radius: var(--r-md);
}
.defect-row {
  display: grid;
  grid-template-columns: 128rpx 1fr auto;
  gap: 12rpx;
  align-items: center;
  margin-top: 12rpx;
}
.defect-qty,
.defect-remark {
  height: 76rpx;
  padding: 0 18rpx;
  color: var(--color-text);
  font-size: 26rpx;
  background: var(--color-bg-input);
  border: 1rpx solid transparent;
  border-radius: var(--r-md);
  box-sizing: border-box;
}
.defect-qty { text-align: center; }
.defect-remove {
  min-width: 72rpx;
  color: #dc2626;
  font-size: 25rpx;
  text-align: center;
}

/* 动作按钮：紧凑、右对齐（与 .submit-row 配合） */
.submit-inline { margin-left: auto; }
