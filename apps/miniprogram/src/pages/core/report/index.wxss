.form-page { min-height: 100vh; padding: 28rpx 30rpx 56rpx; background: #f5f6f8; box-sizing: border-box; }
.form-card { padding: 28rpx; background: #fff; border: 1rpx solid #e5e7eb; border-radius: 16rpx; }
.task-line { display: flex; justify-content: space-between; gap: 20rpx; padding-bottom: 22rpx; margin-bottom: 22rpx; color: #344054; font-size: 27rpx; font-weight: 600; border-bottom: 1rpx solid #eef0f4; }
.field { margin-bottom: 24rpx; }
.field-label { display: block; margin-bottom: 10rpx; color: #475467; font-size: 26rpx; }
.readonly-value, .standard-input, .picker-value { height: 88rpx; padding: 0 20rpx; color: #111827; font-size: 28rpx; line-height: 88rpx; background: #fff; border: 1rpx solid #d0d5dd; border-radius: 10rpx; box-sizing: border-box; }
.readonly-value { color: #667085; background: #f8fafc; }
.quantity-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.quantity-input { height: 112rpx; padding: 0 18rpx; color: #111827; font-size: 42rpx; font-weight: 700; text-align: center; border: 2rpx solid #b8c4d6; border-radius: 10rpx; box-sizing: border-box; }
.placeholder { color: #98a2b3; }
.scan-row { display: flex; align-items: center; gap: 14rpx; }
.scan-input { flex: 1; min-width: 0; }
.scan-button { flex: 0 0 auto; height: 72rpx; padding: 0 22rpx; margin: 0; color: #1677ff; font-size: 26rpx; line-height: 72rpx; background: #fff; border: 1rpx solid #1677ff; border-radius: 10rpx; }
.switch-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; margin-bottom: 24rpx; color: #344054; font-size: 27rpx; border-bottom: 1rpx solid #eef0f4; }
.remark-input { height: 156rpx; padding: 18rpx 20rpx; color: #111827; font-size: 27rpx; border: 1rpx solid #d0d5dd; border-radius: 10rpx; box-sizing: border-box; }
.submit-row { display: flex; justify-content: flex-end; margin-top: 28rpx; margin-left: auto; }
.submit-button { flex: 0 0 auto; min-width: 176rpx; height: 76rpx; padding: 0 26rpx; margin: 0; color: #fff; font-size: 28rpx; line-height: 76rpx; background: #1677ff; border-radius: 10rpx; }
.scan-button::after, .submit-button::after { border: 0; }
