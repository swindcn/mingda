<view class="form-page">
  <view class="form-card">
    <view class="task-line" wx:if="{{task}}">
      <text>{{task.code}}</text>
      <text>{{task.productName}}</text>
    </view>

    <view class="form-field">
      <text class="form-label">报工人</text>
      <view class="readonly-value">{{operatorName}}</view>
    </view>

    <view class="quantity-grid">
      <view class="form-field">
        <text class="form-label">合格数</text>
        <input class="quantity-input" type="number" value="{{qualifiedQuantity}}" placeholder="请输入" placeholder-style="color:#98a2b3" bindinput="inputQualified" />
      </view>
      <view class="form-field">
        <text class="form-label">报废数</text>
        <input class="quantity-input" type="number" value="{{scrapQuantity}}" placeholder="请输入" placeholder-style="color:#98a2b3" bindinput="inputScrap" />
      </view>
    </view>

    <view class="defect-section" wx:if="{{scrapQuantity > 0}}">
      <view class="defect-head">
        <text class="form-label">废品原因</text>
        <text class="defect-add" bindtap="addDefect">+ 新增</text>
      </view>
      <view wx:if="{{!defectRows.length}}" class="defect-empty">有废品时请选择制芯工序缺陷</view>
      <view class="defect-card" wx:for="{{defectRows}}" wx:key="index">
        <picker range="{{options.defects}}" range-key="name" data-index="{{index}}" bindchange="chooseDefect">
          <view class="picker-value {{item.defectCode ? '' : 'placeholder'}}">{{item.defectName || '选择缺陷'}}</view>
        </picker>
        <view class="defect-row">
          <input class="defect-qty" type="digit" value="{{item.quantity}}" data-index="{{index}}" bindinput="inputDefectQty" />
          <input class="defect-remark" value="{{item.remark}}" placeholder="备注" placeholder-style="color:#98a2b3" data-index="{{index}}" bindinput="inputDefectRemark" />
          <text class="defect-remove" data-index="{{index}}" bindtap="removeDefect">删除</text>
        </view>
      </view>
    </view>

    <view class="form-field">
      <text class="form-label">班组</text>
      <picker range="{{options.teams}}" range-key="name" value="{{teamIndex}}" bindchange="selectTeam">
        <view class="picker-value {{teamCode ? '' : 'placeholder'}}">{{teamCode ? options.teams[teamIndex].name : '请选择班组'}}</view>
      </picker>
    </view>

    <view class="form-field">
      <text class="form-label">班次</text>
      <picker range="{{options.shifts}}" range-key="name" value="{{shiftIndex}}" bindchange="selectShift">
        <view class="picker-value {{shiftCode ? '' : 'placeholder'}}">{{shiftCode ? options.shifts[shiftIndex].name : '请选择班次'}}</view>
      </picker>
    </view>

    <view class="switch-row">
      <text>是否烘干</text>
      <switch color="#1677ff" checked="{{dryingRequired}}" bindchange="toggleDrying" />
    </view>

    <view class="form-field">
      <text class="form-label">备注</text>
      <textarea class="remark-input" value="{{remark}}" maxlength="200" placeholder="选填" placeholder-style="color:#98a2b3" bindinput="inputRemark" />
    </view>

    <view class="submit-row">
      <view class="submit-inline" hover-class="submit-inline-hover" bindtap="submit">提交报工</view>
    </view>
  </view>
</view>
