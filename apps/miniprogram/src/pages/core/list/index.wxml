<view class="page">
  <view class="tab-bar cols-3">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'tab-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="changeTab"
    >{{item.label}}</view>
  </view>

  <view class="card-list">
    <view class="core-card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="card-head">
        <text class="task-code">{{item.code}}</text>
        <text class="badge badge-{{item.statusTone === 'done' ? 'done' : item.statusTone === 'muted' ? 'muted' : item.statusTone === 'waiting' ? 'waiting' : 'active'}}">{{item.statusText}}</text>
      </view>
      <view class="product-line">{{item.productName}} · {{item.coreBoxName}}</view>
      <view class="field-grid">
        <view class="field-cell">
          <text class="field-label">计划 / 合格</text>
          <text class="field-value">{{item.plannedQuantity}} / {{item.qualifiedQuantity}}</text>
        </view>
        <view class="field-cell">
          <text class="field-label">设备 / 班组</text>
          <text class="field-value text-ellipsis">{{item.equipmentName}} / {{item.teamName}}</text>
        </view>
      </view>
      <view class="task-time">
        <text>计划时间</text>
        <text>{{item.plannedStartText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !records.length}}" class="empty-state">
    <image class="empty-img" src="/assets/icons/empty-box.svg" />
    <view>当前暂无制芯任务</view>
  </view>
</view>