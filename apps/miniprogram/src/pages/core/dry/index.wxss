.dry-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.section-card {
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

.card-section-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}
.section-bar {
  width: 6rpx;
  height: 28rpx;
  margin-right: 12rpx;
  background: var(--color-primary);
  border-radius: 999rpx;
}
.section-title {
  flex: 1;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}
.selected-count {
  color: var(--color-primary);
  font-size: 25rpx;
  font-weight: 600;
}

.batch-option {
  padding: 22rpx 24rpx;
  margin-top: 14rpx;
  background: var(--color-bg-soft);
  border: 2rpx solid transparent;
  border-radius: var(--r-md);
  box-sizing: border-box;
}
.batch-option-active {
  background: var(--color-primary-tint);
  border-color: var(--color-primary);
}

.batch-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.batch-code {
  flex: 1;
  min-width: 0;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.check-mark {
  flex: 0 0 auto;
  color: var(--color-primary);
  font-size: 25rpx;
  font-weight: 600;
}

.batch-meta {
  margin-top: 12rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.expiry-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 20rpx;
  margin-top: 16rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
  border-top: 1rpx solid var(--color-divider);
}
.expiry-value {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
}
.server-note {
  margin-top: 10rpx;
  color: var(--color-text-placeholder);
  font-size: 22rpx;
  text-align: right;
}

.empty-inline {
  padding: 48rpx 0;
  color: var(--color-text-placeholder);
  font-size: 26rpx;
  text-align: center;
}

/* 动作按钮：紧凑、右对齐（与 .submit-row 配合） */
.submit-inline { margin-left: auto; }
