<view class="dry-page">
  <view class="section-card">
    <view class="card-section-head">
      <view class="section-bar"></view>
      <text class="section-title">待烘干批次</text>
      <text class="selected-count">已选 {{selectedCount}}</text>
    </view>
    <view wx:for="{{displayBatches}}" wx:key="id" class="batch-option {{item.selected ? 'batch-option-active' : ''}}" data-id="{{item.id}}" bindtap="toggleBatch">
      <view class="batch-head">
        <text class="batch-code">{{item.code}}</text>
        <text class="check-mark">{{item.selected ? '✓ 已选' : '选择'}}</text>
      </view>
      <view class="batch-meta">数量 {{item.currentQuantity}}　保质期 {{item.shelfLifeHours || '-'}} 小时</view>
    </view>
    <view wx:if="{{!loading && !batches.length}}" class="empty-inline">暂无待烘干批次</view>
  </view>

  <view class="section-card" wx:if="{{batches.length}}">
    <view class="form-field">
      <text class="form-label">烘干设备</text>
      <picker range="{{options.dryingEquipment}}" range-key="name" value="{{equipmentIndex}}" bindchange="selectEquipment">
        <view class="picker-value {{equipmentCode ? '' : 'placeholder'}}">{{equipmentCode ? options.dryingEquipment[equipmentIndex].name : '请选择烘干设备'}}</view>
      </picker>
    </view>
    <view class="expiry-box">
      <text>预计失效时间</text>
      <text class="expiry-value">{{estimatedExpiresAt}}</text>
    </view>
    <view class="server-note">实际失效时间以提交后服务端计算结果为准</view>
    <view class="submit-row">
      <view class="submit-inline" hover-class="submit-inline-hover" bindtap="submit">确认烘干</view>
    </view>
  </view>
</view>
