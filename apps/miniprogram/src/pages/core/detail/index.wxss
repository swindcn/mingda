.detail-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.card {
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

.card-section-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-bar {
  width: 6rpx;
  height: 28rpx;
  margin-right: 12rpx;
  background: var(--color-primary);
  border-radius: 999rpx;
}
.section-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

/* 摘要 */
.summary-card { padding-bottom: 24rpx; }
.summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.task-code {
  flex: 1;
  min-width: 0;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-name {
  margin-top: 10rpx;
  margin-bottom: 22rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  font-weight: 600;
}
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-divider);
}
.info-cell {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.info-cell-wide {
  grid-column: 1 / -1;
}
.action-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 24rpx;
  margin-left: auto;
}

/* 记录 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.record-item {
  padding: 18rpx 20rpx;
  background: var(--color-bg-soft);
  border-radius: var(--r-md);
}
.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.record-meta { color: var(--color-text); font-size: 28rpx; font-weight: 600; }
.record-time { color: var(--color-text-muted); font-size: 24rpx; }
.record-data {
  margin-top: 10rpx;
  color: var(--color-text);
  font-size: 26rpx;
}
.record-note {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  word-break: break-all;
}
.batch-code {
  flex: 1;
  min-width: 0;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.batch-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.empty-inline {
  padding: 48rpx 0;
  color: var(--color-text-placeholder);
  font-size: 26rpx;
  text-align: center;
}
.empty-page {
  padding: 180rpx 28rpx;
  color: var(--color-text-placeholder);
  font-size: 28rpx;
  text-align: center;
}