.detail-page { min-height: 100vh; padding: 28rpx 30rpx 56rpx; background: #f5f6f8; box-sizing: border-box; }
.summary-card, .section { padding: 26rpx; margin-bottom: 20rpx; background: #fff; border: 1rpx solid #e5e7eb; border-radius: 16rpx; }
.summary-head, .row-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.task-code { min-width: 0; overflow: hidden; font-size: 31rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.status-tag, .batch-status { flex: 0 0 auto; padding: 5rpx 12rpx; color: #0958d9; font-size: 24rpx; background: #e6f4ff; border-radius: 8rpx; }
.product-name { margin-top: 14rpx; color: #344054; font-size: 29rpx; font-weight: 600; }
.info-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx 26rpx; padding-top: 22rpx; margin-top: 20rpx; border-top: 1rpx solid #eef0f4; }
.info-grid > view { display: flex; min-width: 0; flex-direction: column; gap: 7rpx; }
.info-grid .wide { grid-column: 1 / -1; }
.label { color: #98a2b3; font-size: 24rpx; }
.value { overflow-wrap: anywhere; color: #111827; font-size: 28rpx; font-weight: 600; }
.action-row { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 16rpx; margin-top: 26rpx; margin-left: auto; }
.action-button { flex: 0 0 auto; min-width: 152rpx; height: 72rpx; padding: 0 24rpx; margin: 0; font-size: 27rpx; line-height: 72rpx; border-radius: 10rpx; }
.action-button::after { border: 0; }
.primary { color: #fff; background: #1677ff; }
.outline { color: #1677ff; background: #fff; border: 1rpx solid #1677ff; }
.section-title { margin-bottom: 18rpx; color: #111827; font-size: 30rpx; font-weight: 700; }
.record-row { padding: 20rpx 0; border-top: 1rpx solid #eef0f4; }
.record-row:first-of-type { border-top: 0; }
.row-head { color: #475467; font-size: 25rpx; }
.batch-code { min-width: 0; overflow: hidden; color: #111827; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.row-data { margin-top: 12rpx; color: #111827; font-size: 27rpx; }
.row-note { margin-top: 8rpx; color: #667085; font-size: 25rpx; overflow-wrap: anywhere; }
.batch-actions { display: flex; justify-content: flex-end; margin-top: 12rpx; margin-left: auto; }
.label-button { flex: 0 0 auto; min-width: 112rpx; height: 60rpx; padding: 0 22rpx; margin: 0; color: #1677ff; font-size: 25rpx; line-height: 60rpx; background: #fff; border: 1rpx solid #1677ff; border-radius: 8rpx; }
.label-button::after { border: 0; }
.empty-inline, .empty-page { padding: 48rpx 0; color: #98a2b3; font-size: 27rpx; text-align: center; }
.empty-page { padding-top: 180rpx; }
