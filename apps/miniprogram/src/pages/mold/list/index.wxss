.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.search-box {
  margin-bottom: 20rpx;
}
.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
  color: var(--color-text-placeholder);
}

.tab-bar {
  margin-bottom: 24rpx;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.mold-card {
  padding: 28rpx 30rpx 24rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.code {
  flex: 1;
  min-width: 0;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer {
  margin-bottom: 14rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  font-weight: 600;
}

.product-row {
  margin-bottom: 14rpx;
}

.field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx 24rpx;
  margin-bottom: 14rpx;
}
.field-cell {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.field-cell-wide {
  grid-column: 1 / -1;
}
.field-value {
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 600;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-divider);
  gap: 16rpx;
}
.date-cell {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.date-cell-right { text-align: right; }
.date-value {
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 600;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: var(--color-text-muted);
  font-size: 26rpx;
}
.empty-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}