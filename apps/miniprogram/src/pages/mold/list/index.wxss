.mold-list-page {
  min-height: 100vh;
  background: #f6f7f9;
}

.list-content {
  padding: 28rpx 32rpx 42rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  margin-bottom: 30rpx;
  background: #fff;
  border: 1rpx solid #dde3eb;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.archive-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
}

.archive-tab {
  height: 62rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 62rpx;
  text-align: center;
  border-radius: 14rpx;
}

.archive-tab-active {
  color: #fff;
  font-weight: 700;
  background: #1677ff;
}

.search-icon {
  margin-right: 14rpx;
  color: #98a2b3;
  font-size: 32rpx;
}

.search-box input {
  flex: 1;
  font-size: 26rpx;
}

.mold-card {
  padding: 34rpx 30rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.08);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.code {
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
}

.status {
  padding: 4rpx 12rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
}

.status-active,
.status-done {
  color: #165dff;
  background: #e8f1ff;
}

.status-pending {
  color: #d46b08;
  background: #fff2df;
}

.customer {
  margin-top: 14rpx;
  color: #4b5563;
  font-size: 28rpx;
}

.field-row,
.date-row {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
  color: #111827;
  font-size: 28rpx;
  line-height: 38rpx;
}

.field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.label {
  color: #667085;
}

.value {
  flex: 1;
  font-weight: 600;
}

.date-row {
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef0f4;
}

.empty-state {
  padding: 80rpx 0;
  color: #98a2b3;
  font-size: 28rpx;
  text-align: center;
}
