<view class="mold-list-page">
  <view class="list-content">
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input value="{{keyword}}" placeholder="搜索需求编号、客户、产品、供应商或状态等" bindinput="onKeywordInput" />
    </view>

    <view class="mold-card" wx:for="{{molds}}" wx:key="id" bindtap="openDetail" data-id="{{item.id}}">
      <view class="card-head">
        <text class="code">{{item.code}}</text>
        <text class="status status-{{item.statusTone}}">{{item.status}}</text>
      </view>
      <view wx:if="{{!isSupplierEmployee}}" class="customer">{{item.customerName}}</view>
      <view wx:if="{{!isSupplierEmployee}}" class="field-row">
        <text class="label">产品：</text>
        <text class="value">{{item.productCode}} / {{item.productName}}</text>
      </view>
      <view wx:else class="field-row">
        <text class="label">产品：</text>
        <text class="value">{{item.productName}}</text>
      </view>
      <view class="field-grid">
        <view class="field-row">
          <text class="label">模具类型：</text>
          <text class="value">{{item.moldType}}</text>
        </view>
        <view class="field-row">
          <text class="label">跟单人：</text>
          <text class="value">{{item.followerName}}</text>
        </view>
      </view>
      <view class="field-row">
        <text class="label">供应商：</text>
        <text class="value">{{item.supplierName}}</text>
      </view>
      <view class="date-row">
        <view>
          <text class="label">客户告知：</text>
          <text>{{item.notifiedDate}}</text>
        </view>
        <view>
          <text class="label">期望完成：</text>
          <text>{{item.expectedDate}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
