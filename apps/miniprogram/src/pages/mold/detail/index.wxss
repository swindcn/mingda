.detail-page {
  min-height: 100vh;
  background: #f6f7f9;
}

.has-bottom-actions {
  padding-bottom: 132rpx;
}

.detail-content {
  padding: 28rpx;
}

.card {
  padding: 28rpx;
  margin-bottom: 28rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.08);
}

.card-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
}

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #e5e7eb;
}

.info-row {
  display: grid;
  grid-template-columns: 210rpx 1fr;
  gap: 12rpx;
  margin-bottom: 24rpx;
  color: #111827;
  font-size: 28rpx;
  line-height: 40rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #667085;
}

.state-text {
  color: #16a34a;
}

.image-list {
  display: flex;
  gap: 22rpx;
  margin-top: 24rpx;
  overflow-x: auto;
}

.thumb,
.flow-thumb {
  flex: 0 0 auto;
  background: #f0f2f5;
  border-radius: 14rpx;
}

.thumb {
  width: 190rpx;
  height: 190rpx;
}

.flow-item {
  position: relative;
  display: flex;
  min-height: 128rpx;
  color: #98a2b3;
}

.flow-item::before {
  position: absolute;
  top: 34rpx;
  bottom: 0;
  left: 18rpx;
  width: 4rpx;
  background: #d9dee7;
  content: "";
}

.flow-item:last-child::before {
  display: none;
}

.flow-dot {
  position: relative;
  z-index: 1;
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  margin-right: 24rpx;
  background: #fff;
  border: 5rpx solid #d9dee7;
  border-radius: 50%;
  box-sizing: border-box;
}

.flow-done {
  color: #111827;
}

.flow-done::before {
  background: #22c55e;
}

.flow-done .flow-dot {
  border-color: #22c55e;
  background: #22c55e;
}

.flow-body {
  flex: 1;
  min-width: 0;
  padding-bottom: 34rpx;
}

.flow-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 44rpx;
}

.flow-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
}

.node-button {
  flex: 0 0 auto;
  width: auto !important;
  min-width: 0;
  height: 58rpx;
  margin: 0 0 0 auto;
  padding: 0 28rpx;
  color: #fff;
  font-size: 26rpx;
  line-height: 58rpx;
  background: #165dff;
  border-radius: 8rpx;
}

.flow-record {
  padding: 22rpx;
  margin-top: 16rpx;
  color: #475467;
  font-size: 26rpx;
  line-height: 42rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.flow-images {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  overflow-x: auto;
}

.flow-thumb {
  width: 116rpx;
  height: 116rpx;
}

.record-item {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.record-item:last-child {
  margin-bottom: 0;
}

.record-title {
  margin-bottom: 14rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.record-line {
  margin-top: 8rpx;
  color: #475467;
  font-size: 26rpx;
  line-height: 40rpx;
}

.record-section {
  margin-top: 18rpx;
}

.record-subtitle {
  margin-bottom: 12rpx;
  color: #667085;
  font-size: 26rpx;
}

.record-images {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
}

.bottom-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding: 18rpx 28rpx 22rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e5e7eb;
  box-sizing: border-box;
}

.bottom-button {
  height: 82rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 82rpx;
  border-radius: 16rpx;
}

.trial {
  background: #86d39d;
}

.batch {
  background: #165dff;
}

.eval {
  background: #8b00e8;
}
