.detail-page {
  min-height: 100vh;
  background: var(--color-bg);
}
.has-bottom-actions {
  padding-bottom: 140rpx;
}

.detail-content {
  padding: 24rpx 28rpx;
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: var(--color-surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
}

.card-section-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-bar {
  width: 6rpx;
  height: 28rpx;
  margin-right: 12rpx;
  background: var(--color-primary);
  border-radius: 999rpx;
}
.section-title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
}

/* 信息行 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.info-row {
  display: grid;
  grid-template-columns: 200rpx 1fr;
  gap: 16rpx;
  align-items: start;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.5;
}

.thumb-list {
  display: flex;
  gap: 18rpx;
  flex-wrap: wrap;
}

/* 时间线 */
.timeline {
  margin-top: 8rpx;
}
.check-icon {
  display: block;
  width: 20rpx;
  height: 20rpx;
  margin: 6rpx auto;
  color: #fff;
}

/* 开发记录 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.record-item {
  padding: 22rpx 24rpx;
  background: var(--color-bg-soft);
  border-radius: var(--r-md);
}
.record-title {
  margin-bottom: 12rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
}
.record-line {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}
.record-section {
  margin-top: 16rpx;
}
.record-subtitle {
  margin-bottom: 12rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}
.record-images {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}