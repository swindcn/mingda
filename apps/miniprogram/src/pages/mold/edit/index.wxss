.form-title {
  margin-bottom: 28rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.label {
  display: block;
  margin: 24rpx 0 12rpx;
  color: #374151;
  font-size: 26rpx;
}

.form-input,
.input-with-icon .form-input {
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 22rpx;
  color: #111827;
  font-size: 28rpx;
  line-height: 88rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  box-sizing: border-box;
}

textarea {
  width: 100%;
  padding: 20rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.input-with-icon {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.input-with-icon input {
  flex: 1;
  min-width: 0;
}

.scan-button {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  color: #1677ff;
  font-size: 34rpx;
  line-height: 76rpx;
  background: #eaf3ff;
  border-radius: 14rpx;
}

textarea {
  min-height: 180rpx;
}

radio-group {
  display: flex;
  gap: 36rpx;
  margin-bottom: 12rpx;
}

.upload-button {
  flex: 0 0 auto;
  width: auto;
  margin: 0;
  padding: 0 28rpx;
  color: #1677ff;
  background: #eaf3ff;
}

.upload-row {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0 10rpx;
}

.image-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin: 24rpx 0;
}

.image-list image {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
}

.submit-button {
  margin-top: 36rpx;
}
