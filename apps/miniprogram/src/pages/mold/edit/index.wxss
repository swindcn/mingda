.form-title {
  margin-bottom: 28rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.label {
  display: block;
  margin: 24rpx 0 12rpx;
  color: #374151;
  font-size: 26rpx;
}

input,
textarea {
  width: 100%;
  padding: 20rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  box-sizing: border-box;
}

textarea {
  min-height: 180rpx;
}

radio-group {
  display: flex;
  gap: 36rpx;
  margin-bottom: 12rpx;
}

.upload-button {
  margin: 28rpx 0;
  color: #1677ff;
  background: #eaf3ff;
}

.image-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin: 24rpx 0;
}

.image-list image {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
}

.submit-button {
  margin-top: 36rpx;
}
