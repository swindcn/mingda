.form-title {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 16rpx;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 700;
  border-bottom: 1rpx solid var(--color-divider);
}

.input-with-icon {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.input-with-icon .form-input {
  flex: 1;
  min-width: 0;
}

/* 原生 radio（评判结果 / 是否开发完成） */
.radio-group {
  display: flex;
  gap: 32rpx;
}
.radio-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--color-text);
}

.upload-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 16rpx;
}
.image-grid image {
  width: 100%;
  height: 180rpx;
  border-radius: var(--r-md);
  background: var(--color-bg-input);
}
